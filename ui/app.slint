// GC-13：std-widgets 不是语言内建元素，必须显式 import。
// 漏掉会报 "Unknown element 'ListView'"，且错误发生在 build.rs 阶段。
import { Button, ComboBox, LineEdit, ListView, ScrollView, AboutSlint, Palette } from "std-widgets.slint";

export enum NotesStatus { loading, ok, missing, failed }

export component MainWindow inherits Window {
    title: "DSH Manager";
    width: 520px;
    height: 660px;

    // 本窗口是**刻意的浅色设计**（卡片底色全部硬编码为 #f5f5f5 / #fafafa / white），
    // 而 Slint 默认跟随系统主题：Windows 暗色模式下 Palette.foreground 是白色，
    // 于是所有未显式上色的文字都成了白底白字 —— 包括 FR-9 的版本读数、FR-27 的
    // 说明正文，以及 Button 标签与 AboutSlint 内部的文字（后者是 private/内建，
    // **无法逐个补色**）。故把配色方案钉死为浅色：一次让 foreground /
    // control-foreground / control-background 与 AboutSlint 的 logo 选择同时回到浅色。
    // 只能写在 init 里 —— 在组件体里直接写 `Palette.color-scheme: …;` 是语法错误。
    init => { Palette.color-scheme = ColorScheme.light; }

    // ── 版本信息（FR-9）──
    in property <string> installed-version: "检测中…";
    in property <string> installed-channel: "";
    in property <string> latest-version: "";
    in property <bool>   version-known: false;
    in property <bool>   up-to-date: false;

    // ── 选择器（FR-10 / FR-11）──
    in property <[string]> pm-options: [];
    in-out property <int>    pm-index: 0;
    in property <[string]> version-options: [];
    in-out property <int>    version-index: 0;

    // ── dsh web（FR-18）──
    in property <bool>   web-running: false;
    // I-2：`web-running` 在 `Starting` 期间是 false（那时还没有监听者），
    // 所以"正在启动"必须是一个独立属性 —— 否则界面把启动窗口渲染成"已停止"，
    // 而"安装"在 TR-1 最危险的窗口里可点。见 main.rs 的 project()。
    in property <bool>   web-starting: false;
    in property <string> web-url: "";
    in-out property <string> port-text: "3080";

    // ── 更新说明（FR-27）──
    // styled-text 是 Slint 的内建属性类型，对应 Rust 的 slint::StyledText。
    in property <styled-text> notes-text;
    in property <NotesStatus> notes-status: NotesStatus.loading;

    // ── 日志与忙碌态（FR-15 / FR-28）──
    in property <[string]> log-lines: [];
    in property <bool>     busy: false;
    in property <string>   busy-label: "";
    in property <string>   status-text: "";

    // ── 关于对话框（FR-29）──
    in property <string> app-version: "";
    in property <string> dsh-path: "";
    in property <string> owner-pm: "";
    in property <string> current-port: "";

    // 纯窗口本地 UI 状态，不参与 Rust 侧共享状态
    in-out property <bool> about-visible: false;

    callback install-clicked();
    callback pm-changed(int);
    callback version-changed(int);
    callback refresh-clicked();
    callback start-web();
    callback stop-web();
    callback open-web();
    callback port-changed(string);
    callback hide-to-tray();
    callback about-clicked();
    callback link-clicked(string);

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        // ═══ 版本信息 ═══
        Rectangle {
            background: #f5f5f5;
            border-radius: 6px;
            height: 76px;
            HorizontalLayout {
                padding: 10px;
                spacing: 8px;
                VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "已安装"; width: 56px; color: #666; }
                        Text { text: root.installed-version; font-weight: 700; }
                        Text {
                            text: root.installed-channel;
                            color: #0a7; font-size: 11px;
                            vertical-alignment: center;
                            visible: root.installed-channel != "";
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "最新"; width: 56px; color: #666; }
                        Text { text: root.latest-version; visible: root.version-known; }
                        Text {
                            text: "✓ 已是最新";
                            color: #0a7;
                            visible: root.version-known && root.up-to-date;
                        }
                        Text {
                            text: "↓ 可更新";
                            color: #c60;
                            visible: root.version-known && !root.up-to-date;
                        }
                    }
                }
            }
        }

        // ═══ 选择器 + 安装 ═══
        HorizontalLayout {
            spacing: 8px;
            Text { text: "包管理器"; width: 64px; vertical-alignment: center; color: #666; }
            ComboBox {
                model: root.pm-options;
                current-index <=> root.pm-index;
                enabled: !root.busy;
                selected(v) => { root.pm-changed(self.current-index); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Text { text: "目标版本"; width: 64px; vertical-alignment: center; color: #666; }
            ComboBox {
                model: root.version-options;
                current-index <=> root.version-index;
                enabled: !root.busy;
                selected(v) => { root.version-changed(self.current-index); }
            }
            Button {
                text: "安装";
                // I-2 / TR-1：dsh web 正在启动时不得执行变更（见 web-starting 的说明）。
                // 变灰不是唯一的守卫 —— main.rs 的 on_install_clicked 里还有一道，
                // 并会给出可见的状态栏提示（两者条件相同，这里是"点不动"，那里是"说出来"）。
                enabled: !root.busy && !root.web-starting;
                clicked => { root.install-clicked(); }
            }
            Button {
                text: "刷新";
                enabled: !root.busy;
                clicked => { root.refresh-clicked(); }
            }
        }

        // ═══ dsh web ═══
        Rectangle {
            background: #fafafa;
            border-radius: 6px;
            border-width: 1px;
            border-color: #e0e0e0;
            VerticalLayout {
                padding: 10px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    cross-axis-alignment: center;
                    Rectangle {
                        width: 8px; height: 8px; border-radius: 4px;
                        background: root.web-running ? #0c0 : (root.web-starting ? #c60 : #bbb);
                    }
                    Text {
                        // "启动中…" 而不是"已停止"：前者是事实，后者在 Starting 期间是谎话
                        text: root.web-starting ? "启动中…" : (root.web-running ? "运行中" : "已停止");
                        font-weight: 600;
                    }
                    Text {
                        text: root.web-url;
                        color: #06c;
                        visible: root.web-running;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "端口"; vertical-alignment: center; color: #666; }
                    LineEdit {
                        text <=> root.port-text;
                        width: 80px;
                        enabled: !root.busy;
                        edited(t) => { root.port-changed(t); }
                    }
                    Button {
                        text: "启动";
                        // I-2：启动窗口内不给第二次点击（守卫同样在 main.rs 里，
                        // 因为托盘菜单项不受这里的 enabled 约束）。
                        enabled: !root.web-running && !root.busy && !root.web-starting;
                        clicked => { root.start-web(); }
                    }
                    Button {
                        text: "停止";
                        enabled: root.web-running && !root.busy;
                        clicked => { root.stop-web(); }
                    }
                    Button {
                        text: "打开网页";
                        enabled: root.web-running;
                        clicked => { root.open-web(); }
                    }
                }
            }
        }

        // ═══ 更新说明 ═══
        Text {
            text: "更新说明" + (
                root.notes-status == NotesStatus.missing ? " · 该版本无更新说明" :
                root.notes-status == NotesStatus.loading ? " · 加载中…" :
                root.notes-status == NotesStatus.failed  ? " · 加载失败" : ""
            );
            color: #666;
        }
        Rectangle {
            background: white;
            border-radius: 6px;
            border-width: 1px;
            border-color: #e0e0e0;
            min-height: 130px;
            ScrollView {
                // ⚠ StyledText 必须由布局托管，不能直接当 Flickable 的子元素。
                // 隐式尺寸的非布局子元素会被 Slint 在父元素里居中（maybe_center_in_parent）：
                // 实测 257 字正文变成一条 2877px 的单行、左右各溢出卡片 1190px 被裁掉；
                // 而 1275 字的正文（高 442px）会从卡片上方 -148px 开始，开头 10 行看不见。
                // 套一层 VerticalLayout 后正文才既贴左、又按卡片宽度换行、又从顶部开始。
                VerticalLayout {
                    StyledText {
                        text: root.notes-text;
                        default-font-size: 12px;
                        link-clicked(link) => { root.link-clicked(link); }
                    }
                }
            }
        }

        // ═══ 日志（FR-28）═══
        Text { text: "日志"; color: #666; }
        Rectangle {
            background: #1e1e1e;
            border-radius: 6px;
            min-height: 120px;
            // ⚠ 【不要】用 ScrollView 包 ListView。ListView 自己就会滚动；
            // 套一层 ScrollView 会让它按内容全高布局，从而破坏虚拟化 ——
            // 日志上限 2000 行（GC-12），那就等于一次渲染 2000 个 Text。
            ListView {
                for line in root.log-lines : Text {
                    text: line;
                    color: #d4d4d4;
                    font-family: "Consolas";
                    font-size: 11px;
                    wrap: no-wrap;
                }
            }
        }

        // ═══ 底部状态栏 ═══
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.busy ? root.busy-label : root.status-text;
                color: root.busy ? #c60 : #666;
                vertical-alignment: center;
                font-size: 12px;
            }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "关于"; clicked => { root.about-visible = true; root.about-clicked(); } }
            Button { text: "隐藏到托盘"; clicked => { root.hide-to-tray(); } }
        }
    }

    // ═══ 关于对话框（GC-10：AboutSlint 是许可的强制署名义务）═══
    if root.about-visible : Rectangle {
        background: #00000066;
        // 遮罩必须吃掉点击，否则会穿透到后面的按钮
        TouchArea { }
        VerticalLayout {
            alignment: center;
            cross-axis-alignment: center;
            Rectangle {
                background: white;
                border-radius: 8px;
                width: 360px;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text { text: "DSH Manager"; font-size: 18px; font-weight: 700; }
                    Text { text: "管理 DeepSeek Harness 的版本与 Web 服务"; font-size: 12px; color: #666; }
                    Text { text: "程序版本"; font-size: 12px; color: #666; }
                    Text { text: root.app-version; font-size: 12px; }
                    Text { text: "dsh 安装路径"; font-size: 12px; color: #666; }
                    Text { text: root.dsh-path; font-size: 12px; }
                    Text { text: "owner PM"; font-size: 12px; color: #666; }
                    Text { text: root.owner-pm; font-size: 12px; }
                    Text { text: "当前端口"; font-size: 12px; color: #666; }
                    Text { text: root.current-port; font-size: 12px; }
                    AboutSlint { }
                    Button { text: "关闭"; clicked => { root.about-visible = false; } }
                }
            }
        }
    }
}

// 托盘组件是【顶层】组件：inherits SystemTrayIcon，不能放进 Window 里，
// 且必须恰好包含一个 Menu 子元素。
//
// ⚠ 它与 MainWindow 各自持有 global 的独立副本，二者不共享任何状态 ——
// 所有同步必须由 Rust 侧推送（SRS FR-25）。
export component AppTray inherits SystemTrayIcon {
    in property <bool> web-running: false;
    in property <bool> busy: false;

    icon: @image-url("tray-icon.png");
    tooltip: "DSH Manager";

    callback show-window();
    callback open-web();
    callback start-web();
    callback stop-web();
    callback quit-app();
    /// 左键单击托盘图标。⚠ 名字**不能**叫 `clicked` —— Slint 1.18 不把
    /// `SystemTrayIcon.clicked` 这个**内建**回调暴露到生成的 Rust API 上
    /// （同理 `MainWindow` 也拿不到 `close-requested`），只能在组件体内转出去。
    callback tray-clicked();

    Menu {
        MenuItem {
            title: "显示主窗口";
            activated => { show-window(); }
        }
        MenuItem {
            title: "打开 DSH 网页";
            enabled: root.web-running && !root.busy;
            activated => { open-web(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "启动 dsh web";
            enabled: !root.web-running && !root.busy;
            activated => { start-web(); }
        }
        MenuItem {
            title: "停止 dsh web";
            enabled: root.web-running && !root.busy;
            activated => { stop-web(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "退出";
            activated => { quit-app(); }
        }
    }

    clicked => { root.tray-clicked(); }
}
