// ════════════════════════════════════════════════════════════════════════════
//  DSH Manager —— 界面
//
//  设计语言：Ethereal Glass（OLED 近黑 + 径向光晕 + hairline 玻璃卡片）
//  布局原型：Editorial Split（左控制栏 344px / 右输出栏）
//
//  ⚠ 两份契约必须原样保留，改这里就会打断 Rust 侧（src/main.rs 的
//  project() 与 wire_callbacks()）：
//    ① 所有 `in property` / `in-out property` 的名字与类型
//    ② 所有 callback 的名字与签名
//  Rust 侧没有的回调（曾有一个从未接线的 about-clicked）已删除 ——
//  未接线 = 死代码，留着只会诱导下一个人以为它有用。
//
//  ⚠ 平台约束（已在 slint-1.18.0 / i-slint-compiler-1.18.0 源码中核实）：
//    · 不支持 `@font-face` —— 字体只能引用**系统已装**字体，无法内嵌 Geist。
//      故选用 Windows 自带的等宽/可变字体（见 Font 全局）。
//    · 不支持自定义 cubic-bezier 字面量：easing 只能取内建名字。故用
//      `ease-out-quint`（控制点 0.22,1,0.36,1，“重物落定”）与
//      `ease-out-back`（带回弹的按压）—— 语义对上了，名字是 Slint 的。
//    · 不支持 backdrop-blur：玻璃感靠多层半透明 + hairline 内高光模拟。
//    · 不支持背景贴图平铺：颗粒噪点无法用图片实现，故以渐变代替。
// ════════════════════════════════════════════════════════════════════════════

// ⚠ 这里只留**还在用**的。Fluent 的输入框与下拉框已被本文件的 GlassField /
// GlassSelect 取代（见 3xx 行起）—— 它们的圆角/内边距/箭头/弹层全是写死的，
// 改不动，只能自己画。ListView / ScrollView 保留：虚拟化不能丢。
import { ListView, ScrollView, AboutSlint, Palette } from "std-widgets.slint";

export enum NotesStatus { loading, ok, missing, failed }

/// 更新说明里的一个排版块。由 Rust 侧的 `dsh::parse_notes_blocks` 切好推过来 ——
/// Slint 的 `StyledText` 不支持标题（官方 Currently Unsupported 列表里有 Headings），
/// 也没有字重属性，一整段文字表达不了"标题比正文大"，列表也做不出悬挂缩进。
///
/// ⚠ `kind` 的下标与 `src/dsh.rs` 的 `NoteKind` **一一对应**，改顺序要两边一起改
/// （同 `close-behavior-index` 与 `CloseBehavior` 的约定）：
///   0 = 标题 / 1 = 无序列表项 / 2 = 普通段落
export struct NoteBlock {
    kind: int,
    text: styled-text,
}

/// 插件卡的一行（FR-34）。
///
/// ⚠ 字段全是**格式化好的字符串**：可更新与否、显示"未安装"还是"—"都由
/// `src/main.rs` 的 `slint_plugin_rows()` 算完再推（与 `version-options` 同款约定）——
/// Slint 侧不做任何判断，也就不可能与本程序的状态分叉。
export struct PluginRow {
    name: string,
    spec: string,       // package.json 里的原样规格（"^1.1.0" / "1.2.1"）
    installed: string,  // 已装版本；读不到 → "未安装"
    latest: string,     // registry 最新版；查不到 → "—"
    updatable: bool,    // 已装 < 最新（严格小于，降级不算）
    missing: bool,      // 未安装 → 按钮文案改"安装"
}

// ── 设计令牌 ────────────────────────────────────────────────────────────────
// 一处定义，全局引用。
//
// ⚠ 色值锚定 `assets/logo.png`（本机采样，非肉眼估）：
//     头发主蓝 #59659B（占 9.2%，签名色）／发丝高光 #7AA3CD→#95B6E9
//     裙装藏青 #30304E~#3B3C62／围裙暖白 #FDF4F5
// 所以下面三件事是一体的，改一件要一起想：
//   ① 中性色阶是**藏青**不是纯灰（取裙装的色相，压到近黑／提到近白）
//   ② 玻璃层的结构色随主题**反向**（暗色是白 α，浅色必须翻成深 α）
//   ③ 强调色是**紫蓝**不是薄荷 —— logo 里一个绿色像素都没有
//
// ⚠ 双主题：`dark` 由 Rust 唯一写入（`theme::resolve` 的结果），UI 不参与判断，
// 系统态（system_dark）甚至不进本文件。每格写成 `dark ? 暗 : 浅` 是 Slint 自己的
// 形状 —— 见 i-slint-compiler-1.18.0/widgets/fluent/styling.slint:36。
// 浅色侧每个值都在规格 §4.3 验算过 WCAG，改动要走 test(theme) 的对比度回归测试。
//
// 浅色侧要点：accent 用 logo **真实**主蓝 #59659B（暗色侧是提亮版 #9AA6E8）——
// 浅底上必须压深才够 4.87，压深后正好落回 logo 原色。warn/danger 同理必须压深
// （#E3B341 / #F07178 在白底上只有 1.9 / 2.6，不可用）。
export global Tokens {
    /// 当前是否为暗色。Rust 写，其余令牌读。
    in-out property <bool> dark: true;

    out property <brush> canvas:        dark ? #08080F : #EDEFF7;  // 最深/最浅一层
    out property <brush> core-top:      dark ? #12121C : #FFFFFF;  // 卡片内胎（渐变上端）
    out property <brush> core-bottom:   dark ? #0D0D15 : #F6F7FB;  // 卡片内胎（渐变下端）
    out property <brush> shell:         dark ? #EEF0FF06 : #2A2E4A03; // 外碗底
    out property <brush> hairline:      dark ? #EEF0FF12 : #2A2E4A09; // 1px 结构线
    out property <brush> hairline-soft: dark ? #EEF0FF0A : #2A2E4A05;
    out property <brush> hairline-strong: dark ? #EEF0FF33 : #2A2E4A22; // 输入类控件的描边
    out property <brush> inner-light:   dark ? #EEF0FF0E : #FFFFFF99; // 内胎顶缘高光

    out property <brush> ink:           dark ? #EFEFF7 : #191B2A;  // 主文字
    out property <brush> ink-2:         dark ? #AFB0C6 : #4C4F66;  // 正文
    out property <brush> ink-3:         dark ? #7C7D95 : #666980;  // 次级
    out property <brush> ink-4:         dark ? #63647C : #82859B;  // 标签 / 眉标

    out property <brush> accent:        dark ? #9AA6E8 : #59659B;  // 唯一强调色
    out property <brush> accent-ink:    dark ? #BCC5F7 : #3A4270;  // 强调色上的文字
    out property <brush> good:          dark ? #7FB4E4 : #2E6C9E;  // 信息 / 成功
    out property <brush> warn:          dark ? #E3B341 : #8A6200;  // ⚠ 不取自 logo：金蝶结只占 67px(0.05%)

    out property <brush> cta-top:       dark ? #F8F6FA : #59659B;  // 主 CTA（浅色为实心强调色）
    out property <brush> cta-bottom:    dark ? #DCDAE6 : #59659B;
    out property <brush> cta-ink:       dark ? #0B0B14 : #FFFFFF;
    // ⚠ 悬停方向**相反**：暗色白胶囊变亮，浅色实心胶囊必须变深 ——
    // 变浅会让白字掉到 4.36，不达标。
    out property <brush> cta-hover-top:    dark ? #FFFFFF : #4C5788;
    out property <brush> cta-hover-bottom: dark ? #E6E7F2 : #4C5788;
    // 图标井：暗色是白胶囊里的黑井；浅色 CTA 是实心强调色，井翻成白井。
    out property <brush> well:          dark ? #00000024 : #FFFFFF2E;
    out property <brush> well-hover:    dark ? #0000001F : #FFFFFF38;

    out property <brush> glow-brand:    dark ? #9AA6E81F : #59659B14; // 强调色的氛围光
    out property <brush> glow-blue:     dark ? #7FB4E417 : #7FB4E41A;
    out property <brush> top-light:     dark ? #EEF0FF0B : #FFFFFFB3; // 顶部一线竖直渐变
    out property <brush> shadow:        dark ? #00000080 : #2A2E4A33; // 浮层投影
    out property <length> r-lg: 22px;
    out property <length> r-md: 16px;
    out property <length> r-sm: 11px;
    // ⚠ 这里原有 `font-hero: 27px`，随版本主卡的大字号读数一起删除 ——
    // 删掉读数后它没有任何消费者了（设计令牌也不留"以后可能用得上"的空壳）。
    // ⚠ 写这句注释时踩过一坑：`theme.rs` 的 `parse_palette` 把**凡含 brush 类型
    // 字样的行**都当令牌行（它就是这么从本文件里抠出调色板的），所以注释里连
    // "那种令牌的尖括号写法"都不能出现 —— 一出现就被当成令牌行，报"缺冒号"。
    // 删这个令牌不影响那条下限：它只数 brush 类型的行。

    // ── 控制面：所有可点元素共用同一套填充，不允许各自写白百分比 ─────────────
    // 收敛前散着 #FFFFFF08/0D/12/14/17/1F 六个值，四个按钮族各挑一个，
    // 于是"同一档悬停"在四个地方是四种亮度。
    out property <brush> fill:        dark ? #EEF0FF0D : #2A2E4A05; // 静止
    out property <brush> fill-hover:  dark ? #EEF0FF17 : #2A2E4A09; // 悬停
    out property <brush> fill-active: dark ? #EEF0FF1F : #2A2E4A0D; // 按压 / 已展开

    // ── 槽与浮层 ──────────────────────────────────────────────────────────
    out property <brush> sunk:        dark ? #00000059 : #2A2E4A06; // 下凹槽底（输入框 / 下拉框）
    out property <brush> solid:       dark ? #15151F : #FFFFFF;   // 浮层底：不透明，才压得住下层文字
    out property <brush> overlay:     dark ? #000000B8 : #1A1C2E66; // 模态遮罩

    // ── 强调色的四档（静止填充 / 悬停填充 / 描边 / 徽标底）──────────────────
    out property <brush> accent-fill:       dark ? #9AA6E81A : #59659B14;
    out property <brush> accent-fill-hover: dark ? #9AA6E82E : #59659B24;
    out property <brush> accent-line:       dark ? #9AA6E847 : #59659B3D;
    out property <brush> accent-soft:       dark ? #9AA6E812 : #59659B0F;
    out property <brush> warn-soft:         dark ? #E3B34112 : #8A620012;

    out property <brush> danger:      dark ? #F07178 : #9C3F41;   // 错误（日志行）
    out property <brush> lamp-off:    dark ? #494C60 : #B0B3C2;   // 熄灭的状态灯

    // ── 动效与状态（两套主题共用，不参与主题）──────────────────────────────
    // 三档时长：读数变色 400ms / 配色切换 200ms / 按压回弹 150ms。
    // 收敛前是 160/200/260/300/400 五档，差别全在"当时顺手写了多少"。
    out property <duration> motion-slow:  400ms;
    out property <duration> motion-hover: 200ms;
    out property <duration> motion-tap:   150ms;
    /// 状态栏高度。⚠ 两处必须一致：主布局靠 `padding-bottom: Tokens.status-h`
    /// 给贴底的状态栏让位，状态栏自己用它定高 —— 不一致就会出现"内容压在栏上"
    /// 或者"栏上方一条谁也解释不清的空白"。
    out property <length> status-h: 34px;
    /// 不可用元素整体压暗的统一档位（收敛前 0.30 / 0.34 两个值）。
    /// 用 opacity 表达，故两套主题同样成立，不需要按主题分叉。
    out property <float> disabled: 0.35;
}

// ── 排版 ────────────────────────────────────────────────────────────────────
// ⚠ 只能写**单个**家族名：Slint 的 FontRequest.family 是 Option<SharedString>，
// 没有 font-stack 语法，写 "A, B" 会当作一个不存在的家族名而整段回落到默认字体。
// 中文由字体的系统回退承担（Windows 上落到 Microsoft YaHei）。
global Font {
    out property <string> display: "Segoe UI Variable Display"; // 大字号 / 无衬线几何感
    out property <string> text:    "Segoe UI Variable Text";    // 正文
    out property <string> mono:    "Cascadia Mono";             // 日志 / 端口 / 版本号
}

// ── 光晕：背景的氛围层 ──────────────────────────────────────────────────────
// ⚠ 必须是 fixed/装饰性图层，且 pointer-events 为无 —— 它铺满整窗，
// 若参与命中测试会把下面的所有按钮都吃掉。
component Orb inherits Rectangle {
    in property <brush> tint: Tokens.glow-brand;
    background: @radial-gradient(circle, root.tint 0%, transparent 70%);
}

// ── 状态点：一颗会呼吸的灯 ──────────────────────────────────────────────────
component StatusDot inherits Rectangle {
    in property <brush> lamp: Tokens.accent;
    in property <bool>  halo: true;

    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: lamp;

    // 光晕用独立的固定层做，动画只动 opacity —— 不触发布局，永远不重排。
    Rectangle {
        x: -5px; y: -5px; width: 18px; height: 18px; border-radius: 9px;
        background: @radial-gradient(circle, parent.lamp 0%, transparent 68%);
        opacity: halo ? 0.85 : 0;
    }
}

// ── 胶囊按钮（Button-in-Button）─────────────────────────────────────────────
// 主按钮的箭头**不裸放**在文字旁边：它嵌在自己的圆形“井”里，随 hover 沿
// 对角线轻移并微放大 —— 内部动能张力。按压时整体缩到 0.97 模拟物理下陷。
component PillButton inherits Rectangle {
    in property <string> label: "";
    in property <image> glyph;
    in property <bool> show-glyph: true;
    /// 只留图标：不画文字、也不画图标井，按钮退化成正圆。
    /// ⚠ `label` 此时**仍然必须传** —— 它是无障碍树里那个按钮的名字。
    in property <bool> icon-only: false;
    in property <bool> emphasis: false; // false = ghost / true = 主 CTA
    in property <bool> interactive: true;

    callback clicked();

    min-height: 38px;
    min-width: icon-only ? 38px : (emphasis ? 132px : 0px);
    opacity: interactive ? 1 : Tokens.disabled;

    // ⚠ 文字被藏起来之后，子元素里再没有任何东西能给无障碍树当名字 ——
    // 屏幕阅读器只会念到一个"无名按钮"。所以显式给 role + label。
    accessible-role: button;
    accessible-label: root.label;

    background: emphasis
        ? @linear-gradient(180deg, Tokens.cta-top 0%, Tokens.cta-bottom 100%)
        : Tokens.fill;
    border-radius: self.height / 2; // 胶囊：半径永远等于半高
    border-width: emphasis ? 0px : 1px;
    border-color: Tokens.hairline;

    animate background { duration: Tokens.motion-hover; easing: ease-out-quint; }
    animate opacity    { duration: Tokens.motion-hover; easing: ease-out-quint; }

    // ⚠ Slint 1.18 里可以动画的只有「属性」。不存在 `animate scale`，
    // 也不存在 `transform: [ translate-x: … ]` 字面量 —— 已核实编译器源码，
    // 变换类保留属性只有 transform-rotation / transform-scale-x /
    // transform-scale-y / transform-origin。所以：
    //   · 整体按压反馈 -> 一个独立内层做 transform-scale（见下）
    //   · 图标井的对角线位移 -> 图标自身的 x/y（局部重排，代价可忽略）
    Rectangle {
        // 按压反馈层：整块内容缩到 0.97 模拟物理下陷。
        // 它在 self 内居中，缩放以自身中心为原点。
        width: 100%;
        height: 100%;
        transform-scale-x: touch.pressed && root.interactive ? 0.97 : 1;
        transform-scale-y: touch.pressed && root.interactive ? 0.97 : 1;
        animate transform-scale-x { duration: Tokens.motion-tap; easing: ease-out-back; }
        animate transform-scale-y { duration: Tokens.motion-tap; easing: ease-out-back; }

        HorizontalLayout {
            padding-left: icon-only ? 0px : (emphasis ? 18px : 16px);
            padding-right: icon-only ? 0px : (emphasis ? 5px : 16px);
            spacing: icon-only ? 0px : 10px;
            alignment: center;
            // ⚠ 必须显式写 center：cross-axis 的默认值是 stretch，而图标的尺寸是写死的 ——
            // 实测 icon-only 时那枚 17px 图标被顶到 38px 按钮的**上沿**，看着就是没居中。
            cross-axis-alignment: center;

            // ⚠ 这里一律用 `if` 而不是 `visible:` —— Slint 里**不可见的元素照样占布局位置**：
            // 只写 visible: false 时，文字仍占着它的宽度（空串也留了 letter-spacing 那点
            // 余地）、图标井仍占 26px，实测把图标从正中挤偏。`if` 是"根本不存在"，才不占位。
            if !root.icon-only : Text {
                text: root.label;
                color: emphasis ? Tokens.cta-ink : Tokens.ink;
                font-family: Font.text;
                font-size: 12.5px;
                font-weight: emphasis ? 600 : 500;
                letter-spacing: 0.1px;
                vertical-alignment: center;
            }
            if !root.icon-only : Rectangle { horizontal-stretch: 1; }
            // 图标井：圆形容器，箭头嵌在井里而不是裸放在文字旁边。
            // 井的底色也随 hover 提亮一档（白底 CTA 上改用减暗，层次才不乱）。
            // icon-only 时整口井不要了 —— 井是为了给文字旁边的图标一个落点，
            // 没有文字时它就是多余的同心圆。
            if !root.icon-only && root.show-glyph : Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 13px;
                // 井比按钮本体亮一档 —— 井在按钮**里面**，同亮度就"陷"没了；
                // 强调按钮是白底，井改用减暗才看得出层次。
                background: emphasis
                    ? (touch.has-hover ? Tokens.well-hover : Tokens.well)
                    : (touch.has-hover ? Tokens.fill-active : Tokens.fill-hover);
                animate background { duration: Tokens.motion-hover; easing: ease-out-quint; }

                Rectangle {
                    width: 14px;
                    height: 14px;
                    x: touch.has-hover && root.interactive ? 7px : 6px;
                    y: touch.has-hover && root.interactive ? 5px : 6px;
                    animate x { duration: Tokens.motion-hover; easing: ease-out-quint; }
                    animate y { duration: Tokens.motion-hover; easing: ease-out-quint; }
                    Image { width: 100%; height: 100%; source: root.glyph; }
                }
            }
            // icon-only：图标裸放在正圆正中。17px 是井里那枚 14px 图标的放大档 ——
            // 没有文字分担视觉重量时，图标得更实一点。
            if root.icon-only && root.show-glyph : Image {
                width: 17px;
                height: 17px;
                source: root.glyph;
            }
        }
    }

    states [
        hover when touch.has-hover && root.interactive : {
            background: emphasis
                ? @linear-gradient(180deg, Tokens.cta-hover-top 0%, Tokens.cta-hover-bottom 100%)
                : Tokens.fill-hover;
        }
    ]

    touch := TouchArea {
        enabled: root.interactive;
        clicked => { root.clicked(); }
    }
}

// ── 小型胶囊按钮（服务控制用，无图标井）─────────────────────────────────────
component ChipButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> accent: false;
    in property <bool> interactive: true;

    callback clicked();

    min-height: 32px;
    opacity: interactive ? 1 : Tokens.disabled;
    background: accent ? Tokens.accent-fill : Tokens.fill;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: accent ? Tokens.accent-line : Tokens.hairline;

    animate background { duration: Tokens.motion-hover; easing: ease-out-quint; }
    animate opacity    { duration: Tokens.motion-hover; easing: ease-out-quint; }

    // 同 PillButton：按压反馈靠内层的 transform-scale，不存在的 `scale` 属性不用。
    Rectangle {
        width: 100%;
        height: 100%;
        transform-scale-x: touch.pressed && root.interactive ? 0.97 : 1;
        transform-scale-y: touch.pressed && root.interactive ? 0.97 : 1;
        animate transform-scale-x { duration: Tokens.motion-tap; easing: ease-out-back; }
        animate transform-scale-y { duration: Tokens.motion-tap; easing: ease-out-back; }

        HorizontalLayout {
            padding-left: 15px;
            padding-right: 15px;
            alignment: center;
            Text {
                text: root.label;
                color: root.accent ? Tokens.accent-ink : (root.interactive ? Tokens.ink-2 : Tokens.ink-4);
                font-family: Font.text;
                font-size: 12px;
                font-weight: 500;
                vertical-alignment: center;
                animate color { duration: Tokens.motion-hover; easing: ease-out-quint; }
            }
        }
    }

    states [
        hover when touch.has-hover && root.interactive : {
            background: root.accent ? Tokens.accent-fill-hover : Tokens.fill-hover;
        }
    ]

    touch := TouchArea { enabled: root.interactive; clicked => { root.clicked(); } }
}

// ── 眉标：微型大写标签 ──────────────────────────────────────────────────────
// 用途**仅限**分区标题与元信息键（"输出" / "通道最新" / 关于对话框的键）。
// ⚠ 不要拿它当字段标签用：它只有 9.5px，压在 12.5px 的字段文字旁边会显得
// 字号差一大截、也不在同一个视觉高度上（用户报过这条）。字段标签用 FieldLabel。
component Eyebrow inherits Text {
    font-family: Font.text;
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 2px;
    color: Tokens.ink-4;
    vertical-alignment: center;
}

// ── 字段标签：表单里"标签在左、控件在右"的那个标签 ───────────────────────────
// 与字段正文**同字号、同高度**（12.5px / 32px），层次只靠颜色区分
// （标签 ink-3、值 ink），于是标签和框体是齐平的，不再是一小一大两个东西。
component FieldLabel inherits Text {
    font-family: Font.text;
    font-size: 12.5px;
    color: Tokens.ink-3;
    vertical-alignment: center;
    height: 32px;
}

// ── 状态徽标（通道 / 是否最新）─────────────────────────────────────────────
component Tag inherits Rectangle {
    in property <string> label: "";
    in property <color> tint: Tokens.ink-4;
    in property <color> fill: transparent;

    height: 22px;
    min-width: 0px;
    border-radius: 11px;
    background: fill == transparent ? transparent : fill;
    border-width: 1px;
    border-color: tint.with-alpha(0.28);
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        alignment: center;
        Text {
            text: root.label;
            color: root.tint;
            font-family: Font.text;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 1.2px;
            vertical-alignment: center;
        }
    }
}

// ── 应用菜单：菜单栏上的标题（文件 / 帮助）──────────────────────────────────
// ⚠ 下拉面板**不能**放在主布局里：那是 VerticalLayout，而 Slint 拒绝给布局子元素
// 写 x/y（"The property 'y' cannot be set for elements placed in this layout"）。
// 所以标题在主布局的第一行，面板与"点外面就关"的遮罩是 Window 的绝对定位子元素
// （在文件末尾，用标题的 absolute-position 对齐到它正下方）。
component MenuTitle inherits Rectangle {
    in property <string> label: "";
    in property <bool> open: false;
    callback toggled();

    height: 26px;
    min-width: 0px;
    // ⚠ 圆角只有两种语言，别再加第三种：
    //   · 动作按钮（PillButton / ChipButton）→ 胶囊（高度的一半）
    //   · 菜单与字段（本组件 / MenuAction / MenuPanel / GlassField / GlassSelect）→ Tokens.r-sm
    // 收敛前这里写死 8px，于是菜单标题、字段、面板三者三种圆角。
    background: open ? Tokens.fill-active : (touch.has-hover ? Tokens.fill : transparent);
    border-radius: Tokens.r-sm;
    animate background { duration: Tokens.motion-hover; easing: ease-out-quint; }

    // 无障碍：菜单标题就是一个按钮（与 PillButton 同一套路数）。
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.toggled(); }

    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        alignment: center;
        Text {
            text: root.label;
            color: root.open ? Tokens.ink : Tokens.ink-2;
            font-family: Font.text;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea { clicked => { root.toggled(); } }
}

// 下拉里的一行。宽度由下拉面板给（VerticalLayout 的交叉轴默认 stretch），
// 文字靠左、整行可点 —— 与原生菜单一致。
// ⚠ 两个地方共用它：应用菜单（MenuPanel）与 GlassSelect 的选项面板。
// 这就是"下拉框统一"的落点 —— 菜单和下拉不可能再长得不一样。
component MenuAction inherits Rectangle {
    in property <string> label: "";
    /// 当前选中项（只被 GlassSelect 用；应用菜单里恒为 false）。
    in property <bool> current: false;
    callback picked();

    height: 30px;
    border-radius: 6px;
    background: touch.has-hover ? Tokens.fill-hover : (current ? Tokens.fill : transparent);
    animate background { duration: Tokens.motion-hover; easing: ease-out-quint; }

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.picked(); }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: start;
        Text {
            text: root.label;
            color: touch.has-hover || root.current ? Tokens.ink : Tokens.ink-2;
            font-family: Font.text;
            font-size: 12px;
            vertical-alignment: center;
            animate color { duration: Tokens.motion-hover; easing: ease-out-quint; }
        }
    }

    touch := TouchArea { clicked => { root.picked(); } }
}

// ── 浮层底（Flyout）─────────────────────────────────────────────────────────
// 应用菜单的下拉面板与 GlassSelect 的选项面板共用这一层：
// 不透明的 solid 才压得住下面的正文，r-sm 圆角 + hairline 是"玻璃"的边，
// 投影让它看起来是浮起来的而不是贴上去的。
component Flyout inherits Rectangle {
    background: Tokens.solid;
    border-radius: Tokens.r-sm;
    border-width: 1px;
    border-color: Tokens.hairline;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: Tokens.shadow;
}

// ── 1px 结构线 ──────────────────────────────────────────────────────────────
// 抽出来是因为它被抄错过一次：操作卡里那根写成了没有 background 的裸
// Rectangle，于是那条分隔线**根本不存在**（而别处都是 hairline-soft）。
component Divider inherits Rectangle {
    height: 1px;
    background: Tokens.hairline-soft;
}

// ── 区块表头（卡片内部的段落标题）──────────────────────────────────────────
// 服务卡的"输出"与说明卡的"更新说明 · 版本号"原先是两段各自手写的行，
// 一行 24px、一行 30px。
component SectionHeader inherits HorizontalLayout {
    in property <string> label: "";
    /// 标题右侧的次要读数（版本号）。空串 = 不占位。
    /// ⚠ 必须用 if 而不是 visible：Slint 里不可见元素照样占布局位置。
    in property <string> trailing: "";
    height: 30px;
    spacing: 8px;
    alignment: center;

    Eyebrow { text: root.label; }
    if root.trailing != "" : Text {
        text: root.trailing;
        color: Tokens.ink-4;
        font-family: Font.mono;
        font-size: 10px;
        vertical-alignment: center;
    }
}

// ── 关闭按钮（三个对话框共用）──────────────────────────────────────────────
// 原先三个对话框各抄了一份 26px 圆圈：三份都没有 hover 反馈，也没有按压反馈 ——
// 鼠标移上去毫无反应。抽成一处后它们不可能再各自漂移。
component CloseButton inherits Rectangle {
    callback clicked();

    accessible-role: button;
    accessible-label: "关闭";
    accessible-action-default => { root.clicked(); }

    width: 26px;
    height: 26px;
    border-radius: 13px;
    background: touch.has-hover ? Tokens.fill-hover : Tokens.fill;
    border-width: 1px;
    border-color: Tokens.hairline;

    animate background { duration: Tokens.motion-hover; easing: ease-out-quint; }

    Rectangle {
        width: 100%;
        height: 100%;
        transform-scale-x: touch.pressed ? 0.9 : 1;
        transform-scale-y: touch.pressed ? 0.9 : 1;
        animate transform-scale-x { duration: Tokens.motion-tap; easing: ease-out-back; }
        animate transform-scale-y { duration: Tokens.motion-tap; easing: ease-out-back; }

        Image {
            width: 13px; height: 13px;
            source: @image-url("icons/close.svg");
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }

    touch := TouchArea { clicked => { root.clicked(); } }
}

// 下拉面板本体。
// ⚠ 高度必须自己算：它是 Window 的绝对定位子元素，而 Rectangle 的 height 默认
// 取**父元素**高度 —— 不写就会从菜单栏一直通到窗口底部（实测踩过，截图上是一根
// 长条）。高度 = 上下 padding 6*2 + 每项 30 + 项间 2。
component MenuPanel inherits Flyout {
    in property <int> item-count: 1;

    width: 148px;
    height: 12px + item-count * 30px + (item-count - 1) * 2px;

    VerticalLayout {
        padding: 6px;
        spacing: 2px;
        @children
    }
}

// ── 勾选框（询问框的"记住选择"）─────────────────────────────────────────────
// `checked` 是 in-out：调用点用 `<=>` 双向绑到窗口属性上，勾选由本组件自己翻转。
component CheckRow inherits Rectangle {
    in-out property <bool> checked: true;
    in property <string> label: "";

    height: 26px;
    min-width: 0px;
    background: transparent;

    // 无障碍：整行是一个真正的勾选框；默认动作（键盘 / 读屏）与鼠标点击同路。
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-action-default => { root.checked = !root.checked; }

    HorizontalLayout {
        spacing: 8px;
        alignment: center;
        Rectangle {
            width: 15px; height: 15px;
            border-radius: 4px;
            background: checked ? Tokens.accent : transparent;
            border-width: 1px;
            border-color: checked ? Tokens.accent : Tokens.hairline-strong;
            animate background { duration: Tokens.motion-hover; easing: ease-out-quint; }
            animate border-color { duration: Tokens.motion-hover; easing: ease-out-quint; }
            // ⚠ x/y 绝对定位在这里是允许的：父元素是 Rectangle（不是布局元素）。
            Image {
                visible: root.checked;
                width: 11px; height: 11px;
                source: @image-url("icons/check.svg");
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
        Text {
            text: root.label;
            color: Tokens.ink-2;
            font-family: Font.text;
            font-size: 12.5px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea { clicked => { root.checked = !root.checked; } }
}

// ── 双边框嵌套（Doppelrand）─────────────────────────────────────────────────
// 卡片不是平贴在背景上，而是像一块玻璃板坐进铝制托盘：
//   外碗 = 半透明底 + 外 hairline + 大圆角 + 内边距
//   内胎 = 自己的渐变底色 + 顶缘内高光 + 同心的小圆角
// 同心半径是数学算出来的：r-md = r-lg - 6px，两圈弧线才平行。
//
// ⚠ 结构上的两个硬约束（都是实测撞出来的，别改回去）：
//   ① 卡片根必须是 Rectangle：布局元素（VerticalLayout 等）没有 background /
//      border-radius，画不出玻璃。Slint 里能画底的只有 Rectangle / 图片。
//   ② 内胎的布局**不能**绝对定位（写 x/y/width），因为 Slint 会拒绝
//      "The property 'y' cannot be set for elements placed in this layout"；
//      而绝对定位的子元素也不会被 Rectangle 用来推导尺寸，卡片会塌成 0 高。
//   正确写法是让布局做 Rectangle 的**普通子元素**（不写 x/y/width/height）：
//      · 宽度自动填满父容器 → 文本换行高度可算，不会与父高成绑定环
//      · 高度取内容自然高度 → Rectangle 反过来由它定高
//      · 留白由**外层** Rectangle 的 padding 承担（填充矩形不是布局，
//        不会被布局接管几何）
//   这正是 std-widgets 自己的写法（见 fluent/combobox.slint 的 background 层）。
component Bezel inherits Rectangle {
    in property <length> core-padding: 0px;
    // 纵向节奏由外碗透传给内胎布局：卡片根是 Rectangle（为了画玻璃），
    // 它没有 spacing，只能自己开一个转发口。
    in property <length> spacing: 0px;

    // 不参与纵向弹性分配：卡片高度 = 内容高度 + 留白，不是配额。
    // 需要撑满的卡片（服务卡、日志/说明面板）在调用点写 vertical-stretch: 1。
    vertical-stretch: 0;

    background: Tokens.shell;
    border-radius: Tokens.r-lg;
    border-width: 1px;
    border-color: Tokens.hairline;

    Rectangle {
        background: @linear-gradient(168deg, Tokens.core-top 0%, Tokens.core-bottom 100%);
        border-radius: Tokens.r-md;
        border-width: 1px;
        border-color: Tokens.hairline-soft;

        // ⚠ 留白写在**这一层布局**上，不能写在外碗 Rectangle 上：
        // Slint 的 padding 只对布局元素生效，写在 Rectangle 上会被静默忽略
        // 并给出 "padding only has effect on layout elements" 警告 ——
        // 双边框看起来在、实际一点留白都没有。
        VerticalLayout {
            padding: root.core-padding;
            spacing: root.spacing;
            // 内胎顶缘的一线高光 —— 玻璃边缘的折射，是“厚度感”的来源。
            // ⚠ 它是布局的第一个子元素，会占一行高度 —— 这是刻意的：
            // 1px 的代价换来"折射线"落在内容之上而不是被内容盖住。
            Rectangle {
                height: 1px;
                background: Tokens.inner-light;
                opacity: 0.7;
            }
            @children
        }
    }
}

// ── 日志行 ──────────────────────────────────────────────────────────────────
// 语义配色替代线性图标：命令 / 成功 / 警告 / 错误各有自己的颜色。
//
// ⚠ 分类在 Rust 侧完成（push_log 打前缀），这里只认前缀，理由见 push_log：
// Slint 1.18 的 string 成员函数没有 contains，而关键词都在行中间。
//
// ⚠ 这个组件的形状是**实测唯一稳定**的一种：Text 直接做条目根的唯一子元素，
// 且 Text 上不写任何定位/尺寸属性。以下写法全部试过且全部失败：
//   x / y / width: parent.width / width: 100% / width: 420px / wrap: no-wrap
//   → 文字消失、溢出面板、或触发布局绑定环
//   HorizontalLayout + Text            → Text 不是布局认可的"容器型"元素
//     （见 i-slint-compiler 的 layout.rs:allow_in_layout），该格宽度算成 0
//   正文包 Rectangle 配 horizontal-stretch → Rectangle 拿不到拉伸，只有内容宽
//
// ⚠ 左对齐的解法（原先记为"未解决"，这里解掉了）：
// 根因是条目**隐式宽度**（由内容定）会被 Flickable 居中。所以别跟隐式宽度较劲 ——
// 给条目根一个**显式** `width: 100%`（= 父 Flickable 的视口宽），环就断了：
//   条目宽 = 100% 父宽（显式，不反推） → 内容宽不再由子元素决定 → 无环
// 再给 Text 写死 `x: 0` —— 非布局子元素默认在父元素里**居中**，
// 不写这一行，文字会在一整行宽的条目里居中，看起来跟没修一样。两条缺一不可。
//
// ⚠ 与 RULINGS.md Ruling 72 的关系：那条说 "`width: 100%` 对直接的 flickable
// 子元素也不够"。**在 StyledText 上它确实不够**（Ruling 72 的对象是隐式尺寸的
// StyledText）。但同一个旋钮在这个条目上**实测有效**，两者的区别是根元素：
// 这里是 Rectangle 配显式 width，不是隐式尺寸的叶子元素。
// 实测（target/shot-before.png vs shot-step1.png，逐行扫亮像素）：
//   修前三行文字左边缘 183 / 147 / 92（各按自己的宽度居中）
//   修后三行 39 / 38 / 38 —— 与卡片内容框左边缘（x=38）齐平
component LogLine inherits Rectangle {
    in property <string> raw-line: "";
    in property <bool> is-cmd:  raw-line.starts-with("$ ");
    in property <bool> is-ok:   raw-line.starts-with("✓ ");
    in property <bool> is-err:  raw-line.starts-with("ER:");
    in property <bool> is-warn: raw-line.starts-with("WR:");

    width: 100%;
    height: 20px;
    background: transparent;

    Text {
        x: 0;
        text: root.raw-line.replace-all("$ ", "").replace-all("✓ ", "").replace-all("ER:", "").replace-all("WR:", "");
        color: root.is-cmd ? Tokens.accent-ink
             : root.is-err ? Tokens.danger
             : root.is-ok ? Tokens.good
             : root.is-warn ? Tokens.warn
             : Tokens.ink-3;
        font-family: Font.mono;
        font-size: 11px;
        vertical-alignment: center;
    }
}

// ── 插件卡的一行（FR-34）──────────────────────────────────────────────────
// **左两行文字 + 右两个动作**：右栏可用宽度约 388px，单行式塞不下 ——
// 长包名 `@hilariouhiss/dsh-superpowers`（29 字符等宽）自己就约 190px，
// 再加"版本 → 版本"与两个按钮会溢出去。
component PluginRowView inherits Rectangle {
    // ⚠ 属性名不能叫 `row` —— 那是 Slint 的 GridLayout 内附属性名，声明同名会被拒：
    // "Cannot override property 'row'"（实测报在声明行上，信息不指向真正的原因）。
    in property <PluginRow> plugin;
    in property <bool> busy;

    callback update-clicked();
    callback remove-clicked();

    width: 100%;
    height: 40px;
    background: transparent;

    HorizontalLayout {
        spacing: 8px;
        cross-axis-alignment: center;

        VerticalLayout {
            spacing: 1px;
            vertical-stretch: 1;
            alignment: center;   // 文字块在行内垂直居中，与右侧按钮同高

            // 名称：等宽 + 尾部省略。
            // ⚠ Slint 1.18 的 `Text` **没有省略方向**（只有 `overflow: elide|clip`，
            // 省略号固定在尾部）—— 想"中间省略"保住 scope 与包名两头是做不到的，
            // 别去找 `elide:` 属性（它不存在，报的是 "Unknown property elide"）。
            Text {
                text: root.plugin.name;
                color: Tokens.ink;
                font-family: Font.mono;
                font-size: 11.5px;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 6px;
                Text {
                    // "1.2.1 → 1.3.0"；未安装时右端是"—"（由 Rust 格式化好）
                    text: root.plugin.installed + " → " + root.plugin.latest;
                    color: root.plugin.updatable ? Tokens.warn : Tokens.ink-4;
                    font-family: Font.mono;
                    font-size: 10.5px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.plugin.spec;
                    color: Tokens.ink-4;
                    font-family: Font.mono;
                    font-size: 10.5px;
                    vertical-alignment: center;
                }
                // 三种终态各说一句：可更新（由上面那行的颜色 + 按钮表达，这里不说）、
                // 已是最新、最新版未知。⚠ 不可见元素照样占位，但这里是行内**尾随**位置，
                // 留白无害（与操作卡右端那三个 Tag 的情形不同 —— 那边留白会把徽标推离右缘）。
                Text {
                    visible: !root.plugin.updatable && !root.plugin.missing && root.plugin.latest != "—";
                    text: "已是最新";
                    color: Tokens.good;
                    font-family: Font.text;
                    font-size: 10.5px;
                    vertical-alignment: center;
                }
                Text {
                    visible: root.plugin.latest == "—";
                    text: "最新版未知";
                    color: Tokens.ink-4;
                    font-family: Font.text;
                    font-size: 10.5px;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }

        // 更新：只在**确实有更新**或**未安装**时才出现 —— spec §8.2 的
        // "已是最新的行不显示〔更新〕（禁用不如不显示）"。
        // ⚠ 用 `if` 而不是 `interactive: false`：后者会在每行右边留一个点不动的灰按钮，
        // 六行里五行都是它，看着像坏了。未安装时文案改"安装"（走同一条 Update 路径）。
        if root.plugin.updatable || root.plugin.missing : ChipButton {
            label: root.plugin.missing ? "安装" : "更新";
            accent: true;
            interactive: !root.busy && root.plugin.latest != "—";
            clicked => { root.update-clicked(); }
        }
        ChipButton {
            label: "卸载";
            interactive: !root.busy && !root.plugin.missing;
            clicked => { root.remove-clicked(); }
        }
    }
}

// ── 玻璃输入框（取代 Fluent 的 LineEdit）────────────────────────────────────
// 为什么自己画：Fluent 的 LineEdit 把 `min-width: max(160px, …)`、
// `min-height: max(32px, …)`、4px 圆角、浅色底和自己的描边**全写死在组件体里**
// （i-slint-compiler-1.18.0/widgets/fluent/lineedit.slint），而 fluent 的 Palette
// 属性全是 `out`（只读）—— 改不动，只能在外面套框挡。挡出来的结果是
// "外圆角 11px 套内圆角 4px"的双弧线，截图上一眼可见。
// 这里直接在核心元素 TextInput 上起一层自己的壳，圆角/描边/字号全走同一套令牌。
//
// ⚠ 与 Fluent LineEdit 的**功能差异**（有意的，不是漏了）：
//   右键菜单只做「复制 / 粘贴 / 全选」。本程序唯一的调用点是 4 位端口号，
//   撤销 / 重做 / 剪切在那个场景没有意义。Ctrl+C/V/X 由 TextInput 自己处理，不受影响。
component GlassField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text: "";
    in property <bool> enabled: true;
    in property <TextHorizontalAlignment> text-align: center;
    in property <string> font-family: Font.mono;
    in property <length> font-size: 12.5px;

    callback edited(string);

    height: 32px;
    background: Tokens.sunk;
    border-radius: Tokens.r-sm;
    border-width: 1px;
    // 聚焦时整圈换成强调色 —— 键盘用户得看得见焦点落在哪。
    border-color: input.has-focus ? Tokens.accent : Tokens.hairline-strong;
    opacity: enabled ? 1 : Tokens.disabled;
    animate border-color { duration: Tokens.motion-hover; easing: ease-out-quint; }

    // 无障碍：壳负责对外报身份，内部的 TextInput 关掉自己那套（同 Fluent LineEditBase 的做法），
    // 否则读屏会把同一个输入框念两遍。
    accessible-role: text-input;
    accessible-label: root.placeholder-text;
    accessible-value <=> text;
    accessible-enabled: root.enabled;
    accessible-action-set-value(v) => { root.text = v; root.edited(v); }

    // 输入区。
    // ⚠ 这里**不需要**再套 FocusScope / TouchArea 去抢焦点：`TextInput` 在指针按下时
    // 自己就会取焦点（i-slint-core `items/text.rs` 的 `ensure_focus_and_ime`），
    // 实测点进去就有光标、能直接打字（喂 4 位端口号 → state.json 的 preferred_port
    // 真的被改写，说明 edited → port-changed → Rust 这条链是通的）。
    // 右键菜单那块 `ContextMenuArea` 铺满整个字段，但它只吃右键 —— 实测它压在
    // TextInput 上层时左键照样进得去，所以不必像 Fluent 那样把它写成容器。
    // 内缩 9px：壳自带 1px 描边，文字不能贴着它。
    input := TextInput {
        x: 9px;
        y: 0px;
        width: parent.width - 18px;
        height: parent.height;
        text <=> root.text;
        enabled: root.enabled;
        single-line: true;
        horizontal-alignment: root.text-align;
        vertical-alignment: center;
        color: Tokens.ink;
        selection-background-color: Tokens.accent-line;
        selection-foreground-color: Tokens.ink;
        font-family: root.font-family;
        font-size: root.font-size;
        accessible-role: none;

        // ⚠ TextInput 的 edited 回调是**无参**的（Slint 1.18），文本要从 self.text 读
        // —— 写成 `edited(t)` 会报 "only has 0 arguments"。
        edited => { root.edited(self.text); }
    }

    // 占位符：TextInput 自己不画，得叠一层 Text（Fluent 的 LineEdit 也是这么做的）。
    // ⚠ 要连 preedit-text 一起判空 —— 中文输入法正在拼字时 text 还是空的，
    // 只看 text 会让占位符跟候选字叠在一起。
    if root.text == "" && input.preedit-text == "" : Text {
        x: 9px;
        width: parent.width - 18px;
        height: parent.height;
        text: root.placeholder-text;
        color: Tokens.ink-4;
        font-family: root.font-family;
        font-size: root.font-size;
        horizontal-alignment: root.text-align;
        vertical-alignment: center;
        accessible-role: none;
    }

    ContextMenuArea {
        enabled: root.enabled;
        Menu {
            MenuItem { title: "复制"; enabled: !root.text.is-empty; activated => { input.copy(); } }
            MenuItem { title: "粘贴"; enabled: root.enabled; activated => { input.paste(); } }
            MenuItem { title: "全选"; enabled: !root.text.is-empty; activated => { input.select-all(); } }
        }
    }
}

// ── 玻璃下拉框（取代 Fluent 的 ComboBox）────────────────────────────────────
// 与 GlassField 同一个壳，右侧挂一枚本项目自己的箭头（icons/chevron-down.svg）。
// 为什么自己画：Fluent ComboBox 的 3px 圆角、11px 内边距、自带箭头
// （_dropdown.svg）、`min-width: max(160px, …)` 全部写死在组件体里，
// 两个调用点都被迫写 `min-width: 0px; height: 30px` 去压它。
//
// 弹层用核心元素 PopupWindow —— 它就是 Fluent ComboBox 用的那一个（独立窗口，
// 能溢出主窗口边界、自带"点外面就关"、x/y 由运行时换算成绝对坐标），
// 但内容 100% 由本文件画：面板底 = Flyout，选项行 = MenuAction，
// 于是**菜单和下拉框不可能再长得不一样**（同一枚行组件）。
component GlassSelect inherits Rectangle {
    in property <[string]> model: [];
    in-out property <int> current-index: 0;
    in property <bool> enabled: true;

    callback selected(int);

    /// 最多露出几行，超出就滚动 —— 版本列表是 npm registry 的全量版本，会长。
    private property <int> max-visible: 6;
    private property <int> visible-count: min(model.length, max-visible);
    /// 越界（模型变短 / 还没选过）时给空串，不要让下拉显示成空白脏值。
    private property <string> current-value:
        (current-index >= 0 && current-index < model.length) ? model[current-index] : "";

    height: 32px;
    // ⚠ 下拉框**不是**输入框，两者必须一眼分得开：
    //   · 输入框（GlassField）= 下凹的槽（`sunk` 更暗 + `hairline-strong` 描边）→ "这里有光标，能打字"
    //   · 下拉框（本组件）  = 凸起的控件面（`fill` 与按钮同一档 + `hairline` 描边 + 悬停提亮）
    //     → "这里是个按钮，按下去出列表"
    // 两边都沿用同一套令牌，所以这仍然是一套语言里的两种角色，而不是两种风格。
    background: touch.has-hover && root.enabled ? Tokens.fill-hover : Tokens.fill;
    border-radius: Tokens.r-sm;
    border-width: 1px;
    // 展开时和聚焦时同样亮起（is-open 由运行时维护，正是为"下拉开着"设计的）
    border-color: (popup.is-open || keys.has-focus) ? Tokens.accent : Tokens.hairline;
    opacity: enabled ? 1 : Tokens.disabled;
    animate background { duration: Tokens.motion-hover; easing: ease-out-quint; }
    animate border-color { duration: Tokens.motion-hover; easing: ease-out-quint; }

    accessible-role: combobox;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: popup.is-open;
    accessible-value: root.current-value;
    accessible-action-expand => { if root.model.length > 0 { popup.show(); } }

    // 上移 / 下移选中项。到顶到底就不再重复触发 selected ——
    // 每次按键都回调一次会让 Rust 侧白跑一轮重投影。
    function move(delta: int) {
        if (root.model.length == 0) { return; }
        let next = (root.current-index + delta).clamp(0, root.model.length - 1);
        if (next == root.current-index) { return; }
        root.current-index = next;
        root.selected(next);
    }

    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        spacing: 8px;
        alignment: start;
        // ⚠ 必须显式写 center：cross-axis 的默认值是 stretch，而箭头尺寸是写死的
        // —— 不写这一行，那枚 12px 箭头会被顶到 32px 字段的**上沿**，
        // 看起来是"挂在文字结尾的右上角"而不是贴着框体末尾（同一坑见 PillButton）。
        cross-axis-alignment: center;
        Text {
            text: root.current-value;
            color: Tokens.ink;
            font-family: Font.text;
            font-size: 12.5px;
            vertical-alignment: center;
            horizontal-alignment: left;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Image {
            width: 12px;
            height: 12px;
            source: @image-url("icons/chevron-down.svg");
            // 展开时翻个个儿：箭头会说话，就不必再加一行文字说明状态
            transform-rotation: popup.is-open ? -180deg : 0deg;
            animate transform-rotation { duration: Tokens.motion-hover; easing: ease-out-quint; }
        }
    }

    keys := FocusScope {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (!root.enabled) { return reject; }
            if (event.text == Key.DownArrow) { root.move(1); return accept; }
            if (event.text == Key.UpArrow) { root.move(-1); return accept; }
            if (event.text == Key.Return) { popup.show(); return accept; }
            return reject;
        }
        touch := TouchArea {
            enabled: root.enabled;
            clicked => { keys.focus(); if (root.model.length > 0) { popup.show(); } }
        }
    }

    // ⚠ 不要在这里写 `init => { self.focus(); }`：弹层是在启动时就建好的独立
    // 组件，init 抢焦点会让程序一打开就把焦点从主窗口夺走。Fluent 的 ComboBox
    // 同样只靠 forward-focus 把焦点在**弹出时**引过去。
    popup := PopupWindow {
        x: 0px;
        // 往下让 6px：贴着字段底边的话，弹层投影会糊在字段自己的描边上
        y: root.height + 6px;
        width: root.width;
        // 高度 = 面板上下 padding 4*2 + 行高 30 * 行数 + 行间 2 * (行数 - 1)
        height: 8px + visible-count * 30px + (visible-count - 1) * 2px;
        close-policy: close-on-click-outside;
        forward-focus: popup-keys;

        Flyout {
            width: 100%;
            height: 100%;

            popup-keys := FocusScope {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                key-pressed(event) => {
                    if (event.text == Key.DownArrow) { root.move(1); return accept; }
                    if (event.text == Key.UpArrow) { root.move(-1); return accept; }
                    if (event.text == Key.Return || event.text == Key.Escape) { popup.close(); return accept; }
                    return reject;
                }
            }

            // ⚠ 用核心 Flickable 而不是 std 的 ScrollView：后者那根滚动条是 Fluent
            // 画死的（14px 宽、悬停还冒出上下箭头按钮），拿不掉。短列表（≤6 行）时
            // 内容不超出视口，这里就是个不滚动的容器。
            Flickable {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                // 打开时先滚到**当前选中项**那一行 —— Fluent 的 ComboBox 就是这么做的
                // （popup-scroll-y）。少了这一行，选中第 20 个版本再打开下拉，看到的是
                // 前 6 行、高亮那一项在视口外，等于把"当前是哪个"藏了起来。
                // 行高 30 + 行间 2 = 32px。
                // ⚠ 已知特性（实测）：用户一滚轮，Flickable 会自己接管 content-y，
                // 这条声明式绑定就失效了 —— 此后本轮程序里下拉都停在用户滚到的位置。
                // Fluent 的 ComboBox 用的是同一套写法，行为一致，不是这里独有的坑。
                content-y: -max(0, root.current-index - root.visible-count + 1) * 32px;
                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;
                    for value[index] in root.model : MenuAction {
                        label: value;
                        current: index == root.current-index;
                        picked => {
                            root.current-index = index;
                            popup.close();
                            root.selected(index);
                        }
                    }
                }
            }
        }
    }
}

// ── 更新说明的一个块（GitHub 的排版）──────────────────────────────────────
// 三种角色共用一套令牌，字号/缩进/间距按 kind 分：
//   标题   = 15px + Tokens.ink（粗体由 Rust 侧给的 `**…**` 提供）+ 上方留白
//   列表项 = 圆点单独一列 + 正文 —— 于是换行后的第二行挂在**文字**下（悬挂缩进），
//            而不是退回左边缘（那正是 StyledText 内置列表做不到的事）
//   段落   = 12.5px + Tokens.ink-2
// 链接仍由 StyledText 自己渲染（蓝 + 下划线，与改动前一致），色值走 Tokens.good。
component NoteText inherits StyledText {
    in property <int> kind: 2;
    default-font-family: Font.text;
    default-font-size: root.kind == 0 ? 15px : 12.5px;
    default-color: root.kind == 0 ? Tokens.ink : Tokens.ink-2;
    link-color: Tokens.good;
    horizontal-stretch: 1;
}

component NoteBlockView inherits VerticalLayout {
    in property <int> kind: 2;
    in property <styled-text> text;
    callback link-clicked(string);

    spacing: 0px;

    // 块间距**按角色分档**，一律由块自己在上方留白给出（容器的 spacing 是 0）：
    //   · 标题  14px —— GitHub 的小节标题是"隔开上一段"的，不是紧贴
    //   · 段落   8px
    //   · 列表项 3px —— 列表要紧凑。上一版给所有块统一 7px，30 条说明的列表项之间
    //     全都多出一档空气，读起来比 GitHub 散得多。
    // ⚠ 用 if 而不是 visible：Slint 里不可见元素照样占布局位置，那样每一块都会白留一档
    // （同 PillButton、说明区三态那两处的坑）。
    if root.kind == 0 : Rectangle { height: 14px; }
    if root.kind == 2 : Rectangle { height: 8px; }
    if root.kind == 1 : Rectangle { height: 3px; }

    if root.kind == 1 : HorizontalLayout {
        spacing: 7px;
        alignment: start;
        // ⚠ 圆点要跟**首行**对齐，所以是 cross-axis: start 而不是默认的 stretch
        // —— 列表项占三四行时，圆点该留在第一行旁边。
        cross-axis-alignment: start;
        // 圆点用 Rectangle 画，不用 "•" 字形：字形的粗细与高低**随字体而变**
        // （实测默认字体下它偏小、还浮在首行中心之上），这里要的是可控的对齐。
        // 外盒 10×17（17px = 12.5px 正文的行高），圆点 4px 在其中居中
        // → 圆点中心正好落在首行的视觉中心。加上 7px 间距，正文左边缘落在 17px 处，
        // 换行后的第二行也挂在这一列 —— 这就是悬挂缩进的"挂"。
        Rectangle {
            width: 10px;
            height: 17px;
            Rectangle {
                x: 3px;
                y: 6px;
                width: 4px;
                height: 4px;
                border-radius: 2px;
                background: Tokens.ink-3;
            }
        }
        NoteText {
            kind: root.kind;
            text: root.text;
            link-clicked(link) => { root.link-clicked(link); }
        }
    }
    if root.kind != 1 : NoteText {
        kind: root.kind;
        text: root.text;
        link-clicked(link) => { root.link-clicked(link); }
    }
}

// ── 键值行（关于对话框用）───────────────────────────────────────────────────
component MetaRow inherits HorizontalLayout {
    in property <string> k: "";
    in property <string> v: "";
    spacing: 12px;
    Eyebrow { text: root.k; width: 78px; }
    Text {
        text: root.v;
        color: Tokens.ink-2;
        font-family: Font.mono;
        font-size: 11px;
        vertical-alignment: center;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

// ════════════════════════════════════════════════════════════════════════════
export component MainWindow inherits Window {
    title: "DSH Manager";
    // 标题栏 / 任务栏 / Alt-Tab 里的图标。⚠ 路径相对**本文件**（ui/），不是项目根。
    // 为什么是 PNG：Slint 对栅格图**不做缩放**，会把整张 910×941 直接交给 winit 当
    // HICON，由 Windows 自己缩到 16/32px —— 但至少不必像矢量那样先解析上百万字节的
    // 描摹路径、再按内在尺寸栅格化一遍（那一步在 debug 档要 ~1s，见 AppTray 处的记录）。
    icon: @image-url("../assets/logo.png");
    // 双栏布局需要横向空间：单列 520px 时日志与说明只能上下挤叠。
    // Slint 的 Window 不允许 width 与 min-width 同时出现，故只设初始尺寸；
    // 用户手动缩到很窄时日志列会被挤压（列宽随窗口分配），这是可接受的退化。
    width: 880px;
    height: 780px;
    background: Tokens.canvas;

    // ⚠ 配色方案不能留给缺省：Slint 默认跟随系统主题，而 std-widgets
    // （ComboBox / LineEdit / Button / ScrollView / AboutSlint）的配色全部派生自
    // Palette.color-scheme —— 系统是浅色时控件内是黑字，落在本设计的近黑底上等于
    // 不可见。也**不能**用 `ColorScheme.unknown`（那等于跟随系统，与强制档打架）。
    //
    // ⚠ Fluent 控件（ScrollView 滚动条 / AboutSlint）的配色派生自 Palette.color-scheme，
    // 而 FluentPalette 是 std-widgets 的全局，Rust 侧拿不到访问器 ——
    // 所以必须在本文件里跟着 `Tokens.dark` 走。
    //
    // ⚠ 只能写成"局部属性 + changed 处理器里的赋值"：
    // 组件体里直接写 `Palette.color-scheme: …;` 是 Parse error（限定名走不进
    // parser 的绑定分支，见 parser/element.rs 的 parse_element_content），
    // 而 `changed` 里的赋值走的是语句路径，可用。
    // ⚠ `init` 那行**不**负责主题同步：它在 `MainWindow::new()` 里跑，早于 main()
    // 的第一次 `set_dark()`，那时 `Tokens.dark` 还是声明缺省值 `true` —— 于是它**永远**
    // 钉成 dark。运行期的同步全靠 `changed`：`set_dark()` 让 is-dark 变化后由它改写。
    // （离屏探针实测：AboutSlint 的 logo 药丸与默认前景色在 dark=true/false 两档完全互换；
    //   若删掉 `changed`，浅色档的 Fluent 控件会整片停在深色。见 docs/VERIFICATION.md。）
    property <bool> is-dark: Tokens.dark;
    changed is-dark => {
        Palette.color-scheme = is-dark ? ColorScheme.dark : ColorScheme.light;
    }
    init => { Palette.color-scheme = is-dark ? ColorScheme.dark : ColorScheme.light; }

    // ── 版本信息（FR-9 修订）──
    // ⚠ 这里原有 `latest-version`（显示"通道最新 x.y.z"那一行用的），随版本主卡删除 ——
    // 删卡后它没有任何消费者（目标版本下拉的默认选中项就是通道最新版）。
    // 留着它就是一个只有 setter、没有读者的属性。
    in property <string> installed-version: "检测中…";
    in property <bool>   version-known: false;
    /// "是否已是最新"（FR-9）—— 由操作卡「当前版本」右侧的状态徽标消费。
    in property <bool>   up-to-date: false;

    // ── 选择器（FR-10 / FR-11 修订）──
    // ⚠ PM 选择器**已删除**（连同 `pm-options` / `pm-index` / `pm-is-owner` 属性与
    // `pm-changed` 回调）：跨 PM 迁移从界面撤下，变更一律作用于 owner PM
    // （事务引擎仍保留跨 PM 能力，理由见 docs/ARCHITECTURE.md §4.2）。
    in property <[string]> version-options: [];
    in-out property <int>    version-index: 0;

    /// owner PM 的**只读指示**（取代原来的下拉框）。哨兵值与 `installed-version`
    /// 同款纪律：探测未完成是 "检测中…"，探测完成但没找到 dsh 是 "—" ——
    /// 用 "—" 而不是空串：空串会让那一格看着像布局坏了；也**不得**在未探测时
    /// 显示任何结论（SRS:786）。
    in property <string> pm-label: "检测中…";

    // ── dsh web（FR-18）──
    in property <bool>   web-running: false;
    // I-2：`web-running` 在 `Starting` 期间是 false（那时还没有监听者），
    // 所以"正在启动"必须是一个独立属性 —— 否则界面把启动窗口渲染成"已停止"，
    // 而"安装"在 TR-1 最危险的窗口里可点。见 main.rs 的 project()。
    in property <bool>   web-starting: false;
    in property <string> web-url: "";
    in-out property <string> port-text: "3080";

    // ── 更新说明（FR-27）──
    // 按**块**推：每块自带 kind（标题/列表项/段落），由 Rust 侧切好。
    // ⚠ 这里从 `styled-text` 改成块数组是刻意的 —— 一整段 StyledText 不支持标题、
    // 也没有字重，做不到 GitHub 那种"标题比正文大 + 列表悬挂缩进"，理由见
    // dsh::parse_notes_blocks 与 NoteBlock 的注释。
    in property <[NoteBlock]> notes-blocks: [];
    in property <NotesStatus> notes-status: NotesStatus.loading;

    // ── 日志与忙碌态（FR-15 / FR-28）──
    in property <[string]> log-lines: [];
    in property <bool>     busy: false;
    in property <string>   busy-label: "";
    in property <string>   status-text: "";

    // ── 关于对话框（FR-29）──
    in property <string> app-version: "";
    in property <string> dsh-path: "";
    in property <string> owner-pm: "";
    in property <string> current-port: "";

    // 纯窗口本地 UI 状态，不参与 Rust 侧共享状态
    in-out property <bool> about-visible: false;
    in-out property <bool> settings-visible: false;
    /// 首次关闭窗口时的询问框。由 Rust 在 close-requested 里置真
    /// （Rust 侧的 `CloseRequestResponse` 只能"取消这次关闭 + 弹框"，
    /// 没法从回调里返回一个"等用户选完再决定"）。
    in-out property <bool> close-prompt-visible: false;
    /// 询问框里"记住选择"勾选框的当前状态。默认勾上 —— 与原始需求
    /// "首次关闭时询问**默认行为**"一致：问一次就把答案记下来，而不是每次都问。
    in-out property <bool> close-prompt-remember: true;
    /// 关闭主窗口的行为：0 = 隐藏到托盘 / 1 = 退出程序 / 2 = 每次询问。
    /// ⚠ 与 src/config.rs 的 `CloseBehavior` 下标一一对应，改顺序要两边一起改。
    in-out property <int> close-behavior-index: 2;
    /// 主题模式：0 = 浅色 / 1 = 深色 / 2 = 跟随系统。
    /// ⚠ 与 src/theme.rs 的 `ThemeMode` 下标一一对应，改顺序要两边一起改。
    /// 默认 2：与 `state.json` 里没记过时的缺省（跟随系统）一致。
    in-out property <int> theme-mode: 2;
    /// 出网是否走 Windows 系统代理（Ruling 89）。**只描述界面选中态** ——
    /// 出网决策在 `dsh::agent()` 里（worker 线程），它自己读 state.json，
    /// 两边同源所以不会分叉。
    /// 默认 true：与 `state.json` 里"没记过"时的缺省一致，理由见
    /// `config::use_system_proxy()`（机器上没配代理时这一档与直连等价，缺省选它的代价是零）。
    in property <bool> use-system-proxy: true;
    /// 目标版本与当前已装版本**相同**时的确认框（FR-12b）。由 Rust 在
    /// `on_install_clicked` 里置真 —— 判据就是原先行尾"当前"那枚小字用的比较。
    /// 取消 = 这次点击什么也不做（不派发事务）。
    in-out property <bool> reinstall-prompt-visible: false;
    /// 确认框正文里那个版本号（Rust 侧填已装版本号，避免在 Slint 里拼字符串）。
    in property <string> reinstall-version: "";

    // ── 插件卡（FR-34）──
    in property <[PluginRow]> plugin-rows: [];
    /// 卡头右侧的**汇总**（"6 个 · 1 个可更新" / "检查中…" / "读取失败"）。
    in property <string> plugin-summary: "";
    /// 卡底左侧的**状态**（"正在读取 profile 并检查最新版…" / 失败提示 / 成功时为空）。
    /// ⚠ 与 `plugin-summary` 各管一件事，不要合并（spec §8.2）。
    in property <string> plugin-status-line: "";
    in property <bool>   plugins-loading: false;
    /// 〔全部更新〕的启用条件与文案来源。
    in property <int>    plugin-updatable-count: 0;
    /// 卡高由 Rust 按行数算（上限 6 行）—— 理由见 main.rs 的 `plugin_card_height`。
    in property <length> plugin-card-height: 164px;
    /// 安装输入框的当前文本。
    in-out property <string> plugin-input: "";
    /// 卸载确认框（唯一的破坏性动作 → 唯一需要二次确认的地方）。
    in-out property <bool>   plugin-remove-prompt-visible: false;
    in property <string>     plugin-remove-name: "";
    /// 卸载确认框里那句"已装版本 x.y.z"；未安装时是"未安装"。
    in property <string>     plugin-remove-version: "";

    /// 当前展开的应用菜单：0 = 都没开 / 1 = 文件 / 2 = 帮助。
    /// 纯 UI 状态：菜单开着的时候只可能有一个，用一个 int 比两个 bool 少一半状态。
    in-out property <int> open-menu: 0;

    callback install-clicked();
    callback version-changed(int);
    callback refresh-clicked();
    callback start-web();
    callback stop-web();
    callback open-web();
    callback port-changed(string);
    callback settings-changed(int);
    callback theme-mode-changed(int);
    /// 系统代理开关。用 bool 而不是像上面两档那样用下标：那边是**三选一**
    /// 才需要一个 int，两个状态本来就是布尔，多一个"下标 ↔ 枚举"的映射
    /// 只是多一处能写错的地方。
    callback proxy-toggled(bool);
    /// (行为下标, 是否记住)。第二个参数来自询问框的"记住选择"：
    /// 不勾就只管这一次，state.json 不动，下次关闭还会问。
    callback close-choice(int, bool);
    /// 重装确认框里的〔重装〕。取消**不设回调** —— 它只把
    /// `reinstall-prompt-visible` 置假，什么都不做（同关闭询问框的做法）。
    callback reinstall-confirmed();

    // ── 插件卡（FR-34）──
    /// 读 `plugin-input` 并交给 Rust 校验；不合法时只有状态栏提示，不发 Job。
    callback plugin-install();
    /// 行下标 → 更新该行到最新版。
    callback plugin-update(int);
    callback plugin-update-all();
    /// 行下标 → **只弹确认框**，不派发（破坏性动作的二次确认）。
    callback plugin-remove(int);
    /// 确认框里的〔卸载〕→ 才真正派发。
    callback plugin-remove-confirmed();
    callback plugin-refresh();
    /// 应用菜单「文件 → 退出」。与托盘菜单的"退出"走**同一条** Rust 路径
    /// （停掉自己启动的 dsh web 再退出事件循环），所以不经过"关闭时的行为"那一问。
    callback quit-app();
    callback link-clicked(string);

    // ═══ 派生量（纯展示推导，不引入新状态）═══
    // "检测中…" 是 project() 在探测完成前写入的哨兵值；用它区分"还没检测"与
    // "检测完但没装" —— 后者要显示未安装的引导，前者不能下任何结论（SRS:786）。
    property <bool> probing: root.installed-version == "检测中…";
    property <bool> absent:  !root.probing && root.installed-version == "未检测到 dsh";
    property <string> service-state:
        root.web-starting ? "启动中" : (root.web-running ? "运行中" : "已停止");
    property <bool> can-install: !root.busy && !root.web-starting && !root.probing && !root.absent;
    property <bool> has-notes: root.notes-status == NotesStatus.ok;
    property <bool> notes-loading: root.notes-status == NotesStatus.loading;

    // ═══ 氛围层（固定、不参与命中测试）═══
    Orb { width: 560px; height: 560px; x: -180px; y: -220px; tint: Tokens.glow-brand; }
    Orb { width: 640px; height: 640px; x: parent.width - 420px; y: 40px; tint: Tokens.glow-blue; }
    Orb { width: 520px; height: 520px; x: 140px; y: parent.height - 300px; tint: Tokens.glow-brand; }
    // 顶部一线极淡的竖直渐变，让"顶光"方向与所有内高光一致
    Rectangle {
        width: 100%; height: 120px;
        background: @linear-gradient(180deg, Tokens.top-light 0%, transparent 100%);
    }

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 8px;
        // 给贴底的应用状态栏让位（它是 Window 的绝对定位子元素，见文件末尾前一段）
        padding-bottom: Tokens.status-h;
        spacing: 0px;

        // ═════════════════════════ 应用菜单栏 ═══════════════════════════════
        // 「关于 / 设置」原先挤在底部状态栏那排按钮里 —— 那是窗口级动作的位置，
        // 而这两件事是程序级入口。改成常见 Windows 应用的菜单栏：文件、帮助。
        // ⚠ 不放在标题栏里（VS Code 那种自绘标题栏）：那要 no-frame + 自己接管
        // 拖动 / 最大化 / 贴边吸附，为了两个菜单项把原生窗口行为全赔进去不划算；
        // 而且你已经把 logo 放进系统标题栏了，那行还是留给系统画。
        //
        // ⚠ `alignment: start` 是必须的：默认对齐会把富余宽度摊给每一项（实测把
        // 图标按钮撑到 121px），两个菜单标题会被拉成两根长条。
        HorizontalLayout {
            height: 30px;
            spacing: 4px;
            alignment: start;

            file-menu := MenuTitle {
                label: "文件";
                open: root.open-menu == 1;
                toggled => { root.open-menu = root.open-menu == 1 ? 0 : 1; }
            }
            help-menu := MenuTitle {
                label: "帮助";
                open: root.open-menu == 2;
                toggled => { root.open-menu = root.open-menu == 2 ? 0 : 2; }
            }
        }

        Rectangle { height: 10px; }

        // ═══════════════════════ 主体：双栏 ═══════════════════════════════
        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            // ───────────────────── 左：控制栏 ─────────────────────
            VerticalLayout {
                // ⚠ 344 → 420px：日志搬进这一栏后，`$ npm.cmd install -g
                // @deepseek-ai/dsh@0.1.6-alpha.2` 这类原文在 344px 里放不下（11px 等宽
                // 约 52 字符 ≈ 345px），会溢出卡片被裁。右栏剩 420px 仍够读说明。
                width: 420px;
                spacing: 12px;

                // ⚠ 这里原有**版本主卡**（大字号读数 + 状态徽标 + 通道最新一行），
                // 已整卡删除。它的两块信息各有了新落点：
                //   · "是否已是最新"（FR-9）→ 操作卡「当前版本」右侧的状态徽标；
                //   · "通道最新 x.y.z"       → 不再单独显示：目标版本下拉的**默认选中项**
                //     就是通道内最新版，同一个值说两遍只是多一行。
                // 左栏因此从三张卡收敛为两张（操作卡 + 服务卡）。

                // 操作卡
                // 操作卡：两个字段 + 一行动作。
                // ⚠ 字段原本是「眉标压在选择器上面」的两行结构，实测每字段 ~68px，
                // 两个字段加动作行要 194px，而左栏在 660px 窗口里只能给它 169px ——
                // 于是 PillButton 被压到下限以下、直接裁出卡片外面。
                // 改成「眉标在左、选择器在右」的单行结构：每字段 38px，
                // 总高降到 ~150px，既瘦下来又更像仪表盘（标签与读数同行，扫读更快）。
                Bezel {
                    core-padding: 16px;
                    spacing: 8px;

                    // ⚠ 这两行都**不能**写 alignment: center：那样每行会各自把自己那组
                    // 居中，而两行的内容宽度不同（下拉里选中的文字长短不一），于是两个
                    // 标签的左边距对不齐 —— 看着就是"错位"。用默认对齐 + 标签写死 62px，
                    // 两行左边缘就都从同一条线开始（下拉吃掉剩下的宽度）。
                    HorizontalLayout {
                        spacing: 10px;
                        // ⚠ cross-axis-alignment: center 是**必需**的：默认的 stretch 会把
                        // 22px 高的 Tag 顶到 32px 行的上沿（服务卡的状态点踩过同一条坑）。
                        cross-axis-alignment: center;
                        FieldLabel { text: "包管理器"; width: 62px; }
                        // 只读指示（FR-11 修订）：本程序不再提供 PM 选择器 ——
                        // 从界面发起的变更一律作用于**当前 owner PM**，跨 PM 迁移已从
                        // 界面撤下（引擎仍保留，见 ARCHITECTURE §4.2）。
                        // ⚠ 文案必须与 `installed-version` 同款哨兵纪律：探测未完成时是
                        // "检测中…"，此时**不得**显示"未检测到"（SRS:786）。
                        Text {
                            text: root.pm-label;
                            color: root.probing || root.absent ? Tokens.ink-4 : Tokens.ink;
                            font-family: Font.mono;
                            font-size: 12.5px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        // 右半回答"当前是什么版本"。它原先是大字号读数（已随版本主卡删除），
                        // 现在只在这里出现一次 —— 所以用正文色 + 等宽，不再用 ink-4。
                        FieldLabel { text: "当前版本"; }
                        Text {
                            text: root.installed-version;
                            color: root.probing || root.absent ? Tokens.ink-4 : Tokens.ink;
                            font-family: Font.mono;
                            font-size: 12.5px;
                            vertical-alignment: center;
                        }
                        // FR-9 的"是否已是最新"结论随版本主卡搬到这里：挂在版本号右侧，
                        // 与它判断的那个读数挨着。（"通道最新 x.y.z"不再单独显示 ——
                        // 目标版本下拉的默认选中项就是它。）
                        // ⚠ 这里用 `if` 而不是 `visible:`：三个 Tag 里最多亮一个，而
                        // **不可见的 Tag 照样占着两侧 9px 的 padding** —— 离屏探针实测
                        // 两枚隐藏 Tag 白占 36px，把"已是最新"从卡片右边缘推开约 54px，
                        // 同时把左侧两组挤到几乎贴在一起（`npm` 止于 x123、`当前版本`
                        // 从 x144 就开始）。`if` 是"根本不存在"，这一行才恢复成
                        // "左一组 / 右一组"的仪表盘读法。
                        if root.version-known && root.up-to-date : Tag {
                            label: "已是最新";
                            tint: Tokens.accent;
                            fill: Tokens.accent-soft;
                        }
                        if root.version-known && !root.up-to-date : Tag {
                            label: "可更新";
                            tint: Tokens.warn;
                            fill: Tokens.warn-soft;
                        }
                        if root.probing : Tag {
                            label: "检测中";
                            tint: Tokens.ink-4;
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        FieldLabel { text: "目标版本"; width: 62px; }
                        GlassSelect {
                            horizontal-stretch: 1;
                            model: root.version-options;
                            current-index <=> root.version-index;
                            enabled: !root.busy;
                            selected(i) => { root.version-changed(i); }
                        }
                        // ⚠ 行尾那句"当前"已按需求删除（连同 `version-is-current` 属性）。
                        // 它回答的是"我选中的是不是现在装着的"—— 这个问题现在由**点击时**的
                        // 确认框回答（FR-12b）：选中的就是已装版本时，〔安装〕先弹
                        // "是否重新安装"，而不是在行尾常驻一枚小字。
                    }
                    // "未在 PATH 上找到 dsh"的引导（原在版本主卡里）。搬到这里 ——
                    // 未检测到 dsh 时它必须还能看见，而那张卡已经没有了。
                    // ⚠ 用 `if` 而不是 `visible:`：不可见元素照样占布局位置
                    // （Slint 的既有坑，本文件多处已记），这行只在异常态出现，不该留空位。
                    if root.absent : Text {
                        text: "未在 PATH 上找到 dsh。先装一个包管理器版本，再从下方选目标版本。";
                        color: Tokens.ink-3;
                        font-family: Font.text;
                        font-size: 11.5px;
                        wrap: word-wrap;
                    }

                    // ⚠ 这是分隔线，不是空行 —— 原先写成没有 background 的裸
                    // Rectangle，于是这条线**根本不存在**（服务卡同位置是真线）。
                    Divider { }
                    HorizontalLayout {
                        spacing: 9px;
                        // 两个字面按钮都只剩图标（图标本身已经说明动作），
                        // 所以它们不再撑满整行 —— 挤出多余的宽度，动作簇靠右收口，
                        // 与"读数在左、动作在右"的仪表盘读法一致。
                        Rectangle { horizontal-stretch: 1; }
                        PillButton {
                            icon-only: true;
                            // ⚠ 宽度必须写死：HorizontalLayout 默认会把富余宽度摊给**每一项**
                            // （实测两个图标按钮各被撑到 121px，图标浮在胶囊右侧）。
                            // `min-width` 只保底、挡不住拉伸，固定 width 才挡得住。
                            width: 38px;
                            // ⚠ label 不显示，只作为无障碍名字存在（见 PillButton）。
                            // busy 文案同理不进按钮，改由状态栏与忙碌脉冲条承担 ——
                            // 一个圆按钮塞不下"准备中…"，硬塞回去就是又把文字加回来。
                            label: root.busy ? root.busy-label : "安装";
                            // arrow-down-to-line：向下落到一条横线上 = "装到本机"，
                            // 比原来的 arrow-up-right 更贴"安装"这件事。
                            glyph: @image-url("icons/arrow-down-to-line.svg");
                            emphasis: true;
                            // I-2 / TR-1：dsh web 正在启动时不得执行变更。
                            // 变灰不是唯一的守卫 —— main.rs 的 on_install_clicked
                            // 里还有一道，并会给出可见的状态栏提示。
                            interactive: root.can-install;
                            clicked => { root.install-clicked(); }
                        }
                        PillButton {
                            icon-only: true;
                            width: 38px;
                            label: "刷新";
                            glyph: @image-url("icons/refresh.svg");
                            interactive: !root.busy;
                            clicked => { root.refresh-clicked(); }
                        }
                    }
                }

                // 服务卡：撑满左栏剩下的高度
                // 服务卡吃掉左栏最后一块空间：弹性的，窗口变高时它变高，
                // 而不是在底部留一条谁也解释不清的空白。
                Bezel {
                    vertical-stretch: 1;
                    core-padding: 16px;
                    VerticalLayout {
                        spacing: 14px;

                        // ⚠ 这两行**不要**写 alignment: center。
                        // 收敛前它们是居中的，而同一张卡里的日志列表是左对齐的，
                        // 于是同一张卡内两种对齐并存（另外三张卡的内容一律从内容框左边缘
                        // 起排，操作卡的注释里也写着同一条规则）。现在的读法全卡统一：
                        // **读数从左边起，尾随动作靠右收口**。
                        HorizontalLayout {
                            spacing: 10px;
                            // ⚠ 同状态栏：cross-axis 默认 stretch，8px 的状态点会被顶到行上沿
                            // —— 不写这一行，点就悬在"运行中"三个字的左上角。
                            cross-axis-alignment: center;
                            StatusDot {
                                lamp: root.web-starting ? Tokens.warn
                                    : (root.web-running ? Tokens.accent : Tokens.lamp-off);
                                // 停止时不留光晕：一颗暗灯不该发光
                                halo: root.web-running || root.web-starting;
                            }
                            Text {
                                text: root.service-state;
                                color: Tokens.ink;
                                font-family: Font.text;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                visible: root.web-running;
                                text: root.web-url;
                                color: Tokens.good;
                                font-family: Font.mono;
                                font-size: 10.5px;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: 9px;
                            FieldLabel { text: "端口"; }
                            // 一个 GlassField 就位。
                            // 收敛前这里是三层：74px 外框 + 内层 VerticalLayout +
                            // 两条 3px padding —— 全部是为了挡住 Fluent LineEdit 那个
                            // `min-width: max(160px, …)`（不挡就往右溢出 86px，把自带的
                            // 浅色底糊在"启动"按钮上）。自己画的组件宽度就是宽度，
                            // 三层收成一层，连那条 hack 注释一起删掉了。
                            GlassField {
                                width: 74px;
                                text <=> root.port-text;
                                enabled: !root.busy;
                                placeholder-text: "3080";
                                edited(t) => { root.port-changed(t); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            // 三个服务动作改成图标按钮（原先是"启动/停止/打开"文字胶囊）。
                            // 用与安装/刷新同一枚 PillButton 的 icon-only 档：正圆、图标居中、
                            // label 只作无障碍名字。谁是"可用动作"由 enabled 状态本身表达 ——
                            // 停止时只有"启动"是亮的，运行时只有"停止/打开"是亮的，
                            // 所以不给任何一个加白底强调，免得跟安装按钮抢注意力。
                            PillButton {
                                icon-only: true;
                                label: "启动 dsh web";
                                glyph: @image-url("icons/play.svg");
                                // I-2：启动窗口内不给第二次点击
                                interactive: !root.web-running && !root.busy && !root.web-starting;
                                clicked => { root.start-web(); }
                            }
                            PillButton {
                                icon-only: true;
                                label: "停止 dsh web";
                                glyph: @image-url("icons/square.svg");
                                interactive: root.web-running && !root.busy;
                                clicked => { root.stop-web(); }
                            }
                            PillButton {
                                icon-only: true;
                                label: "在浏览器里打开 dsh web";
                                glyph: @image-url("icons/external-link.svg");
                                interactive: root.web-running;
                                clicked => { root.open-web(); }
                            }
                        }

                        // 弹性撑杆（原先在这里）已换成下面的日志区：日志就是这块区域
                        // 干活的输出，放在同一条纵向节奏里比塞一根空撑杆更有意义。

                        // ═══════════════════ 应用输出（FR-28）═══════════════════
                        // 原先是右栏上半独立的一块面板，现按需求**并入本区域下方**：
                        // "输出"是这块区域（探测 / 安装事务 / dsh web 启停）干出来的东西，
                        // 挨着它看才有因果。
                        // ⚠ 右栏因此整个让给更新说明（长文阅读需要整列宽度与高度）。
                        Divider { }
                        SectionHeader { label: "输出"; }
                        // ⚠ 【不要】用 ScrollView 包 ListView。ListView 自己就会滚动；
                        // 套一层 ScrollView 会让它按内容全高布局，从而破坏虚拟化 ——
                        // 日志上限 2000 行（GC-12），那就等于一次渲染 2000 个 Text。
                        ListView {
                            // ⚠ vertical-stretch 必须写：布局子元素默认 0，不写会让
                            // ListView 按内容高度居中停在面板正中。
                            vertical-stretch: 1;
                            // 并入左侧窄栏后要有下限：窗口不够高时 ListView 会被压成一条缝。
                            min-height: 120px;
                            // ⚠ 不要给 ListView 写 padding：它是 ScrollView，不是布局
                            // 元素，padding 会被静默忽略（并给出编译警告）。
                            for line in root.log-lines : LogLine { raw-line: line; }
                        }
                        // 空状态不在这里做：本面板的子元素全部是布局项，任何
                        // 额外子元素都会与 ListView 抢剩余高度（实测把日志区挤成 0），
                        // 而 Slint 的布局又拒绝绝对定位的装饰层（"The property 'y'
                        // cannot be set for elements placed in this layout"）。

                        // 忙碌条：不确定进度，所以是条来回跑的脉冲而不是假百分数
                        Rectangle {
                            visible: root.busy;
                            height: 2px;
                            border-radius: 1px;
                            background: Tokens.hairline;
                            Rectangle {
                                width: 96px;
                                height: 2px;
                                border-radius: 1px;
                                background: @linear-gradient(90deg, transparent 0%, Tokens.accent 50%, transparent 100%);
                                animate x {
                                    duration: 1400ms;
                                    iteration-count: -1;
                                    easing: ease-in-out;
                                }
                                x: 0px;
                                states [
                                    run when root.busy : { x: parent.width - self.width; }
                                ]
                            }
                        }
                    }
                }
            }

            // ───────────────────── 右：插件卡 + 更新说明 ─────────────────────
            // 应用输出已并入左栏的服务区（见上），右栏上半给插件卡（FR-34）、
            // 下半给更新说明 —— 长文阅读需要的是宽度和高度。
            VerticalLayout {
                horizontal-stretch: 1;
                // 两张卡之间要留缝，与左栏的 12px 一致（原先是 0px，只有一张卡）
                spacing: 12px;

                // ═══════════════════ 插件卡（FR-34）═══════════════════
                Bezel {
                    // ⚠ 高度由 Rust 推（`plugin-card-height`）：按行数取、上限 6 行。
                    // Slint 侧做不了"内容自适应但封顶" —— `ListView` 没有可读的内容高度，
                    // 而用 `ScrollView` 包它会破坏虚拟化（日志区已记过这条坑）。
                    height: root.plugin-card-height;
                    SectionHeader {
                        label: "插件";
                        // ⚠ 空串即不占位（Slint 里不可见元素照样占宽），SectionHeader 内部
                        // 已经按这条处理过 trailing。
                        trailing: root.plugin-summary;
                    }
                    HorizontalLayout {   // 安装行
                        spacing: 8px;
                        GlassField {
                            horizontal-stretch: 1;
                            text <=> root.plugin-input;
                            // 包规格是"文本"不是"读数"：左对齐 + 正文体（端口的 4 位数字
                            // 才用居中 + 等宽）。
                            text-align: left;
                            font-family: Font.text;
                            font-size: 12px;
                            enabled: !root.busy;
                            placeholder-text: "@scope/name 或 @scope/name@1.2.3";
                            edited(t) => { root.plugin-input = t; }
                        }
                        ChipButton {
                            label: "安装";
                            accent: true;
                            interactive: !root.busy && root.plugin-input != "";
                            clicked => { root.plugin-install(); }
                        }
                    }
                    Divider { }
                    // ⚠ 不要用 ScrollView 包 ListView（虚拟化会失效）。
                    // ⚠ 也不要在 ListView 上写 padding（它是 ScrollView，不是布局元素，
                    // padding 会被静默忽略并给出编译警告）。
                    ListView {
                        vertical-stretch: 1;
                        min-height: 40px;
                        for p[i] in root.plugin-rows : PluginRowView {
                            plugin: p;
                            busy: root.busy;
                            update-clicked => { root.plugin-update(i); }
                            remove-clicked => { root.plugin-remove(i); }
                        }
                    }
                    HorizontalLayout {   // 汇总行：状态在左、动作在右
                        spacing: 8px;
                        cross-axis-alignment: center;
                        Text {
                            text: root.plugin-status-line;
                            color: Tokens.ink-4;
                            font-family: Font.text;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        ChipButton {
                            label: "全部更新";
                            accent: root.plugin-updatable-count > 0;
                            interactive: !root.busy && root.plugin-updatable-count > 0;
                            clicked => { root.plugin-update-all(); }
                        }
                        ChipButton {
                            label: "刷新";
                            interactive: !root.plugins-loading && !root.busy;
                            clicked => { root.plugin-refresh(); }
                        }
                    }
                }

                // 更新说明（FR-27）
                // ⚠ 标题移进面板**内部**顶部居中（原先在面板外侧单独占一行）。
                // 版本号与标题**同一个居中簇**：它是元数据但不是标题，紧跟在标题后面
                // 读起来像副标题。⚠ 不要用"左右两格夹住标题"那种写法 —— 实测空格子
                // 不会被撑开，标题会贴在左边（Slint 布局分配富余宽度的行为与直觉不同）。
                Bezel {
                    vertical-stretch: 1;
                    // 独占整列后下限提一点：这是唯一的长文区，窗口再矮也别压成一条缝。
                    min-height: 260px;
                    SectionHeader {
                        label: "更新说明" + (
                            root.notes-status == NotesStatus.missing ? " · 该版本无更新说明" :
                            root.notes-status == NotesStatus.loading ? " · 加载中…" :
                            root.notes-status == NotesStatus.failed  ? " · 加载失败" : ""
                        );
                        // ⚠ 空串即不占位：原先用 visible 控制，而 Slint 里不可见元素
                        // 照样占着它那格宽度（等宽字体的字距也算），标题会被推偏。
                        trailing: root.has-notes && root.version-index >= 0
                                  && root.version-index < root.version-options.length
                                  ? root.version-options[root.version-index] : "";
                    }
                    // ⚠ 这三段内容必须用 `if` 而不是 `visible:` —— Slint 里**不可见的元素
                    // 照样占布局位置**：骨架屏（4 行 × 11px + 3 × 9px 间距 ≈ 71px）与空状态
                    // 即使 visible: false，也会先把高度从 Bezel 的内胎里吃掉，ScrollView
                    // 的视口因此被砍短近百像素 —— 表现就是"正文被提前遮住、下面留一条黑带、
                    // 还得滚动才看得全"（实测：说明区最后一行文字在 y=667，而面板底边在
                    // y≈789，空掉 122px）。同一条坑在 PillButton 里也踩过：只隐藏不消失，
                    // 位置照样留着。`if` 是"根本不存在"。
                    if root.notes-status == NotesStatus.ok : ScrollView {
                        vertical-stretch: 1;
                        // ⚠ StyledText 必须由布局托管，不能直接当 Flickable 的子元素。
                        // 隐式尺寸的非布局子元素会被 Slint 在父元素里居中
                        // （maybe_center_in_parent）：实测 257 字正文变成一条 2877px 的
                        // 单行、左右各溢出卡片 1190px 被裁掉；而 1275 字的正文（高 442px）
                        // 会从卡片上方 -148px 开始，开头 10 行看不见。
                        // 套一层 VerticalLayout 后正文才既贴左、又按卡片宽度换行、又从顶部开始。
                        //
                        // ⚠ 这里 spacing 必须是 0：块间距按角色分档（标题 14 / 段落 8 /
                        // 列表项 3），由 NoteBlockView 自己在上方留白给出。写成统一值
                        // 就会在所有列表项之间也塞一档空气，比 GitHub 散得多。
                        // 字号 / 字体 / 正文色 / 链接色统一在 NoteText 里，别在调用点重写。
                        VerticalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            spacing: 0px;
                            for block in root.notes-blocks : NoteBlockView {
                                kind: block.kind;
                                text: block.text;
                                link-clicked(link) => { root.link-clicked(link); }
                            }
                        }
                    }
                    // 骨架屏：形状与正文一致，比转圈的 spinner 更少突兀
                    //
                    // ⚠ `preferred-height: 100%` 这一条是**修跳动的关键**，别删。
                    // 本卡的高度是**由内容顶出来的**（见 Bezel 的注释："高度取内容自然
                    // 高度 → Rectangle 反过来由它定高"），调用点那个 `vertical-stretch: 1`
                    // 顶不动它。于是三种状态各自的"内容想多高"就决定了卡片多高：
                    //   · 正文态：内容是 std 的 ScrollView，它自带 `preferred-height: 100%`
                    //     → 卡片顶到整列全高；
                    //   · 骨架屏/空状态：内容只有几根写死高度的条 → 卡片只剩 `min-height`
                    //     （260px）。
                    // 实测：同一块区域加载期 260px、说明到位后 ~700px —— 启动过程中先矮
                    // 后高地跳一下（用户报的）。三条状态统一"想占满"就没有这一跳了。
                    if root.notes-loading : VerticalLayout {
                        preferred-height: 100%;
                        padding-left: 4px;
                        spacing: 9px;
                        Rectangle { height: 11px; width: 62%; border-radius: 5px; background: Tokens.hairline-soft; }
                        Rectangle { height: 11px; width: 88%; border-radius: 5px; background: Tokens.hairline-soft; }
                        Rectangle { height: 11px; width: 74%; border-radius: 5px; background: Tokens.hairline-soft; }
                        Rectangle { height: 11px; width: 41%; border-radius: 5px; background: Tokens.hairline-soft; }
                        // 撑杆：几根骨架条留在顶部，但**容器自己**占满卡片高度。
                        // 没有它，上面那条 preferred-height 只是"想更高"，布局不会真给。
                        //
                        // ⚠ 试过、并**否掉**的两种"填满 700px 高卡片"的做法（都实测过）：
                        //   · 下面垫一块渐隐的实心矩形 → 顶上一条全宽的硬边 + 均匀亮度，
                        //     看着就是一块矩形污渍，不像正文（截图 target/crop-v2.png）；
                        //   · 循环生成几十根条 → 条数写死就适应不了任何窗口高度：
                        //     多了会把卡片顶高（又跳一次），少了照样填不满。
                        // 正文态本来就是"从顶到底一整块密排文字"，而加载态只持续到
                        // 网络抓完说明（本机通常是几百毫秒）—— 为这几百毫秒做一块
                        // 假正文不值。骨架条 + 标题里的"· 加载中…"已经说清楚了。
                        Rectangle { vertical-stretch: 1; }
                    }
                    // 空状态：该版本没有说明，说清楚而不是留一片白
                    // ⚠ 同样写 preferred-height：否则从"加载中"切到"没有说明"时卡片
                    // 会再缩回去一次 —— 那就把刚修掉的跳动换个时机又演一遍。
                    if root.notes-status == NotesStatus.missing
                    || root.notes-status == NotesStatus.failed : VerticalLayout {
                        preferred-height: 100%;
                        alignment: center;
                        Text {
                            text: root.notes-status == NotesStatus.missing
                                ? "该版本没有附带更新说明"
                                : "更新说明加载失败，稍后重试";
                            color: Tokens.ink-4;
                            font-family: Font.text;
                            font-size: 11.5px;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }

        Rectangle { height: 12px; }
    }

    // ══════════════════════════ 应用状态栏 ══════════════════════════════
    // 只留状态：关于 / 设置 已搬进上方的应用菜单栏。
    //
    // ⚠ 为什么它是 Window 的绝对定位子元素，而不是主布局的最后一行：
    // 主布局左右各有 14px 内容留白，而状态栏要**整宽贴底**（条带越过留白，
    // 文字再自己缩进 14px）。写进主布局里就只能缩在留白内；要让它整宽就得把
    // 整块主体再套一层布局 —— 那是 500 行的重新缩进，为一条状态栏不值。
    // 所以主布局改成 `padding-bottom: Tokens.status-h` 给它让位，本组件贴底。
    // 声明顺序在主布局**之后**、菜单与对话框**之前**：盖住内容，但不盖弹层。
    Rectangle {
        y: parent.height - self.height;
        width: 100%;
        height: Tokens.status-h;
        background: Tokens.shell;

        // 顶边一线：把状态栏与内容区分开（窗口级的分隔线，比卡片内的 hairline-soft 实一档）
        Rectangle {
            y: 0px;
            width: 100%;
            height: 1px;
            background: Tokens.hairline;
        }

        HorizontalLayout {
            y: 1px;
            width: 100%;
            height: parent.height - 1px;
            padding-left: 14px;
            padding-right: 14px;
            spacing: 10px;
            // ⚠ `alignment: start`：默认对齐会把富余宽度摊给每一项 —— 这条规则以前把
            // 那两个按钮撑成 131px，现在只剩状态灯与文字，留着它会把文字推离左边。
            alignment: start;
            // ⚠ 必须显式写 center：cross-axis 的默认值是 stretch，而状态点的尺寸是写死的
            // 8px —— 不写这一行，那颗点会被顶到状态栏的**上沿**，看起来挂在文字的左上角
            // （用户报的就是这条）。同一坑见 PillButton 的图标与 GlassSelect 的箭头。
            cross-axis-alignment: center;

            StatusDot {
                lamp: root.busy ? Tokens.warn
                    : (root.web-starting ? Tokens.warn
                    : (root.web-running ? Tokens.accent : Tokens.lamp-off));
                halo: root.busy || root.web-running || root.web-starting;
            }
            Text {
                text: root.busy ? root.busy-label
                    : (root.status-text != "" ? root.status-text
                    : (root.probing ? "正在探测本地环境…" : "就绪"));
                color: root.busy ? Tokens.warn
                     : (root.status-text != "" ? Tokens.ink-3 : Tokens.ink-4);
                font-family: Font.text;
                font-size: 11.5px;
                vertical-alignment: center;
                animate color { duration: Tokens.motion-slow; easing: ease-out-quint; }
            }
        }
    }

    // ═══════════════════════ 应用菜单的下拉面板 ═══════════════════════════
    // ⚠ 必须是 Window 的直接子元素（绝对定位）。放进主 VerticalLayout 里会被拒：
    // "The property 'y' cannot be set for elements placed in this layout"。
    // 声明顺序在主体之后、对话框之前 —— 于是它盖住内容，又不会盖住对话框。
    if root.open-menu != 0 : Rectangle {
        // 点面板外面任何地方都关掉。铺满整窗、在面板**之下**（先声明者在下）。
        TouchArea { clicked => { root.open-menu = 0; } }
        // Esc 也关（菜单的惯例）。与三个对话框同一套路数：空壳 FocusScope 不自己
        // 抢焦点就收不到按键（那条是实测踩出来的，见询问框处）。
        FocusScope {
            init => { self.focus(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.open-menu = 0; return accept; }
                return reject;
            }
        }
    }
    if root.open-menu == 1 : MenuPanel {
        x: file-menu.absolute-position.x;
        y: file-menu.absolute-position.y + file-menu.height + 4px;
        item-count: 2;
        MenuAction {
            label: "设置";
            picked => { root.open-menu = 0; root.settings-visible = true; }
        }
        MenuAction {
            label: "退出";
            picked => { root.open-menu = 0; root.quit-app(); }
        }
    }
    if root.open-menu == 2 : MenuPanel {
        x: help-menu.absolute-position.x;
        y: help-menu.absolute-position.y + help-menu.height + 4px;
        item-count: 1;
        MenuAction {
            label: "关于 DSH Manager";
            picked => { root.open-menu = 0; root.about-visible = true; }
        }
    }

    // ═══════════════════════════ 关于（FR-29）═══════════════════════════
    // GC-10 / CON-8：AboutSlint 是 Slint 免版税许可的**强制署名义务**，不可删。
    if root.about-visible : Rectangle {
        background: Tokens.overlay;
        // 遮罩必须吃掉点击，否则会穿透到后面的按钮
        TouchArea { clicked => { root.about-visible = false; } }
        // Esc 关闭：模态的唯一无鼠标出口
        // ⚠ 空壳 FocusScope 必须自己抢焦点：默认只有"被点到"才会获得焦点
        // （focus-on-click），而这里没有任何可点的内容 —— 不写这一行，Esc 是死的
        // （已实测：真按键发进来，弹窗纹丝不动）。
        FocusScope {
            init => { self.focus(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.about-visible = false; return accept; }
                return reject;
            }
        }

        VerticalLayout {
            alignment: center;
            cross-axis-alignment: center;
            Bezel {
                width: 400px;
                core-padding: 20px;
                spacing: 0px;

                    // ⚠ 这里**不要**写 alignment: center —— 那样 spacer 一点都不吃宽度
                    // （实测两个弹窗的标题和 × 挤在中间）。用默认对齐时 spacer 才会
                    // 把 × 顶到最右，标题留在最左（另一处实测：动作卡的图标按钮就是这么靠右的）。
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: "DSH Manager";
                            color: Tokens.ink;
                            font-family: Font.display;
                            font-size: 17px;
                            font-weight: 600;
                            letter-spacing: -0.2px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        CloseButton { clicked => { root.about-visible = false; } }
                    }
                    Rectangle { height: 4px; }
                    Text {
                        text: "管理 DeepSeek Harness 的版本与 Web 服务";
                        color: Tokens.ink-4;
                        font-family: Font.text;
                        font-size: 11.5px;
                    }
                    Rectangle { height: 18px; }
                    Divider { }
                    Rectangle { height: 16px; }

                    VerticalLayout {
                        spacing: 11px;
                        MetaRow { k: "程序版本"; v: root.app-version; }
                        MetaRow { k: "dsh 路径"; v: root.dsh-path; }
                        MetaRow { k: "owner PM"; v: root.owner-pm; }
                        MetaRow { k: "当前端口"; v: root.current-port; }
                    }

                    Rectangle { height: 18px; }
                    Divider { }
                    Rectangle { height: 16px; }

                    HorizontalLayout {
                        alignment: center;
                        AboutSlint { }
                    }
            }
        }
    }

    // ═══════════════════════════ 设置 ═══════════════════════════════════
    // 目前两组：关闭行为、主题。做成一个独立面板而不是往主界面再塞一行控件，
    // 是因为状态栏那排按钮是"窗口级动作"，而设置是"程序级配置"，两者不该并排。
    if root.settings-visible : Rectangle {
        background: Tokens.overlay;
        TouchArea { clicked => { root.settings-visible = false; } }
        // ⚠ 空壳 FocusScope 必须自己抢焦点：默认只有"被点到"才会获得焦点
        // （focus-on-click），而这里没有任何可点的内容 —— 不写这一行，Esc 是死的
        // （已实测：真按键发进来，弹窗纹丝不动）。
        FocusScope {
            init => { self.focus(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.settings-visible = false; return accept; }
                return reject;
            }
        }

        VerticalLayout {
            alignment: center;
            cross-axis-alignment: center;
            Bezel {
                width: 400px;
                core-padding: 20px;
                spacing: 0px;

                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: "设置";
                        color: Tokens.ink;
                        font-family: Font.display;
                        font-size: 17px;
                        font-weight: 600;
                        letter-spacing: -0.2px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    CloseButton { clicked => { root.settings-visible = false; } }
                }
                Rectangle { height: 18px; }
                Divider { }
                Rectangle { height: 16px; }

                Eyebrow { text: "关闭主窗口时"; }
                Rectangle { height: 10px; }
                // 选中态就是 ChipButton 的 accent：同一个组件、只换颜色，
                // 不做单选圆点 —— 三选一的语义靠强调色已经足够清楚。
                HorizontalLayout {
                    spacing: 8px;
                    ChipButton {
                        label: "隐藏至托盘";
                        accent: root.close-behavior-index == 0;
                        clicked => { root.settings-changed(0); }
                    }
                    ChipButton {
                        label: "彻底退出";
                        accent: root.close-behavior-index == 1;
                        clicked => { root.settings-changed(1); }
                    }
                    ChipButton {
                        label: "每次询问";
                        accent: root.close-behavior-index == 2;
                        clicked => { root.settings-changed(2); }
                    }
                }
                Rectangle { height: 12px; }
                Text {
                    text: "首次关闭窗口时会先问一次，勾了“记住选择”的那个答案就落在这里，随时可改。选“彻底退出”会连同本程序启动的 dsh web 一起停掉。";
                    color: Tokens.ink-4;
                    font-family: Font.text;
                    font-size: 11.5px;
                    wrap: word-wrap;
                }

                Rectangle { height: 16px; }
                Divider { }
                Rectangle { height: 16px; }

                Eyebrow { text: "主题"; }
                Rectangle { height: 10px; }
                HorizontalLayout {
                    spacing: 8px;
                    ChipButton {
                        label: "浅色";
                        accent: root.theme-mode == 0;
                        clicked => { root.theme-mode-changed(0); }
                    }
                    ChipButton {
                        label: "深色";
                        accent: root.theme-mode == 1;
                        clicked => { root.theme-mode-changed(1); }
                    }
                    ChipButton {
                        label: "跟随系统";
                        accent: root.theme-mode == 2;
                        clicked => { root.theme-mode-changed(2); }
                    }
                }
                Rectangle { height: 12px; }
                Text {
                    // ⚠ 这里必须诚实交代标题栏的限制，否则用户会当成 bug 报：
                    // 强制档只改窗口内部，系统标题栏跟着的是**系统**设置。
                    text: "跟随系统时窗口与标题栏会一起变。选「浅色」「深色」只改窗口内部 —— 系统标题栏由 Windows 画，它跟的是系统设置，本程序无法覆盖。";
                    color: Tokens.ink-4;
                    font-family: Font.text;
                    font-size: 11.5px;
                    wrap: word-wrap;
                }

                Rectangle { height: 16px; }
                Divider { }
                Rectangle { height: 16px; }

                Eyebrow { text: "网络代理"; }
                Rectangle { height: 10px; }
                HorizontalLayout {
                    spacing: 8px;
                    ChipButton {
                        label: "使用系统代理";
                        accent: root.use-system-proxy;
                        clicked => { root.proxy-toggled(true); }
                    }
                    ChipButton {
                        label: "直连";
                        accent: !root.use-system-proxy;
                        clicked => { root.proxy-toggled(false); }
                    }
                }
                Rectangle { height: 12px; }
                Text {
                    // ⚠ 必须交代"只影响本程序自己的出网"。`dsh web` 是**另一个进程**，
                    // 它跟的是它自己的环境变量，本程序管不着 —— 不写清楚，
                    // 用户会以为切了这一档 dsh web 的流量也跟着变（问过，见需求澄清）。
                    text: "只影响本程序自己的出网（版本目录、更新说明）—— dsh web 是独立进程，不受这一档影响。读的是 Windows「Internet 选项」里的代理；机器上没配代理时与「直连」等价。";
                    color: Tokens.ink-4;
                    font-family: Font.text;
                    font-size: 11.5px;
                    wrap: word-wrap;
                }
            }
        }
    }

    // ═══════════════════════ 卸载插件的确认（FR-37）═══════════════════════
    // 插件卡上唯一的**破坏性**动作，因此是本功能唯一的二次确认。
    // 点遮罩 / Esc / 右上角关闭 = 取消这次卸载（同关闭询问框与重装框的做法）。
    if root.plugin-remove-prompt-visible : Rectangle {
        background: Tokens.overlay;
        TouchArea { clicked => { root.plugin-remove-prompt-visible = false; } }
        FocusScope {
            init => { self.focus(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.plugin-remove-prompt-visible = false; return accept; }
                return reject;
            }
        }

        VerticalLayout {
            alignment: center;
            cross-axis-alignment: center;
            Bezel {
                width: 400px;
                core-padding: 20px;
                spacing: 0px;

                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: "卸载插件";
                        color: Tokens.ink;
                        font-family: Font.display;
                        font-size: 16px;
                        font-weight: 600;
                        letter-spacing: -0.2px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    CloseButton { clicked => { root.plugin-remove-prompt-visible = false; } }
                }
                Rectangle { height: 12px; }
                Text {
                    text: root.plugin-remove-name;
                    color: Tokens.ink;
                    font-family: Font.mono;
                    font-size: 12.5px;
                    wrap: no-wrap;
                    overflow: elide;
                }
                Rectangle { height: 7px; }
                Text {
                    text: "将从 profile 移除该依赖（已装版本 "
                        + (root.plugin-remove-version == "" ? "未知" : root.plugin-remove-version)
                        + "）。卸载后如需恢复，可重新安装。";
                    color: Tokens.ink-2;
                    font-family: Font.text;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Rectangle { height: 18px; }
                // ⚠ 强调放在**推荐动作**上（最右）。这里的推荐动作是〔取消〕——
                // 与重装框相反：那边点下去只是重装一遍，这边是不可逆的删除。
                HorizontalLayout {
                    spacing: 9px;
                    Rectangle { horizontal-stretch: 1; }
                    ChipButton {
                        label: "卸载";
                        interactive: !root.busy;
                        clicked => {
                            root.plugin-remove-prompt-visible = false;
                            root.plugin-remove-confirmed();
                        }
                    }
                    ChipButton {
                        label: "取消";
                        accent: true;
                        clicked => { root.plugin-remove-prompt-visible = false; }
                    }
                }
            }
        }
    }

    // ═══════════════════════ 同版本重装的确认（FR-12b）═══════════════════
    // 目标版本 == 已装版本时，〔安装〕不再静默地"装一个一模一样的"，先问一句。
    // 点遮罩 / Esc / 右上角关闭 = 取消这次点击，什么都不做 —— 与关闭询问框同一套。
    // 版本号由 Rust 填进 `reinstall-version`（不在 Slint 里拼字符串 —— 本文件里所有
    // 面向用户的拼接都在 project() 完成，见"下拉里只放格式化字符串"那条约定）。
    if root.reinstall-prompt-visible : Rectangle {
        background: Tokens.overlay;
        TouchArea { clicked => { root.reinstall-prompt-visible = false; } }
        // ⚠ 空壳 FocusScope 必须自己抢焦点（同关闭询问框：不写这一行 Esc 是死的）。
        FocusScope {
            init => { self.focus(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.reinstall-prompt-visible = false; return accept; }
                return reject;
            }
        }

        VerticalLayout {
            alignment: center;
            cross-axis-alignment: center;
            Bezel {
                width: 400px;
                core-padding: 20px;
                spacing: 0px;

                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: "重新安装";
                        color: Tokens.ink;
                        font-family: Font.display;
                        font-size: 16px;
                        font-weight: 600;
                        letter-spacing: -0.2px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    CloseButton { clicked => { root.reinstall-prompt-visible = false; } }
                }
                Rectangle { height: 12px; }
                // ⚠ 拆成两句而不是一段话：原本写成
                // "目标版本与当前已安装的版本相同（<版本>）。是否重新安装？"，
                // 离屏探针实测**第二行只剩 17px 宽** —— 那个"？"被挤到第二行单独挂尾
                // （正文带 y 384..394 的 x 聚类是 260..277）。版本号长度可变，所以
                // 靠调整字号/宽度去凑是不稳的：把可变部分（版本号）单独放一行，
                // 固定那句控制在一行内（23 个汉字 ≈ 287px < 内容宽度 360px）。
                Text {
                    text: "当前已是 " + root.reinstall-version;
                    color: Tokens.ink;
                    font-family: Font.mono;
                    font-size: 12.5px;
                    wrap: no-wrap;
                }
                Rectangle { height: 7px; }
                Text {
                    text: "目标版本与当前已安装的版本相同，是否重新安装？";
                    color: Tokens.ink-2;
                    font-family: Font.text;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Rectangle { height: 18px; }
                // ⚠ 强调放在**推荐动作**上，且它在最右（与关闭询问框同一条规则：
                // 那边最右是"隐藏至托盘"，这里最右是"重装"）。重装是非破坏动作，
                // 所以强调给它；取消保持普通样式。
                HorizontalLayout {
                    spacing: 9px;
                    Rectangle { horizontal-stretch: 1; }
                    PillButton {
                        label: "取消";
                        show-glyph: false;
                        clicked => { root.reinstall-prompt-visible = false; }
                    }
                    PillButton {
                        label: "重装";
                        emphasis: true;
                        show-glyph: false;
                        clicked => {
                            // 先关框再确认：确认会派发事务并把 busy 置真，
                            // 框留着会挡住忙碌脉冲条与状态栏。
                            root.reinstall-prompt-visible = false;
                            root.reinstall-confirmed();
                        }
                    }
                }
            }
        }
    }

    // ═════════════════════════ 首次关闭的询问 ═══════════════════════════
    // 只有 `close-behavior-index` 还是"每次询问"时才可能被 Rust 置真。
    // 点遮罩或按 Esc = 放弃这次关闭，窗口留着（我们不替用户做决定）。
    if root.close-prompt-visible : Rectangle {
        background: Tokens.overlay;
        TouchArea { clicked => { root.close-prompt-visible = false; } }
        // ⚠ 空壳 FocusScope 必须自己抢焦点：默认只有"被点到"才会获得焦点
        // （focus-on-click），而这里没有任何可点的内容 —— 不写这一行，Esc 是死的
        // （已实测：真按键发进来，弹窗纹丝不动）。
        FocusScope {
            init => { self.focus(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.close-prompt-visible = false; return accept; }
                return reject;
            }
        }

        VerticalLayout {
            alignment: center;
            cross-axis-alignment: center;
            Bezel {
                width: 400px;
                core-padding: 20px;
                spacing: 0px;

                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: "关闭时的行为";
                        color: Tokens.ink;
                        font-family: Font.display;
                        font-size: 16px;
                        font-weight: 600;
                        letter-spacing: -0.2px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    // 右上角关闭 = 与 Esc / 点遮罩同义：放弃这次关闭，窗口留着。
                    CloseButton { clicked => { root.close-prompt-visible = false; } }
                }
                Rectangle { height: 14px; }
                HorizontalLayout {
                    alignment: center;
                    CheckRow {
                        checked <=> root.close-prompt-remember;
                        label: "记住选择";
                    }
                }
                Rectangle { height: 8px; }
                // 小字紧跟"记住选择"这一行：它解释的正是上面那个勾选框。
                Text {
                    text: "勾选后这次选择会记为默认行为，之后可在设置里修改。";
                    color: Tokens.ink-4;
                    font-family: Font.text;
                    font-size: 11px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Rectangle { height: 18px; }
                // 两个动作做成按钮、落在底部右侧（对话框的惯用位置）。
                // 点一下**就是**决定本身（随即隐藏或退出），没有"选中再确认"那一步。
                HorizontalLayout {
                    spacing: 9px;
                    Rectangle { horizontal-stretch: 1; }
                    PillButton {
                        label: "彻底退出";
                        show-glyph: false;
                        clicked => { root.close-choice(1, root.close-prompt-remember); }
                    }
                    PillButton {
                        label: "隐藏至托盘";
                        emphasis: true;
                        show-glyph: false;
                        clicked => { root.close-choice(0, root.close-prompt-remember); }
                    }
                }
            }
        }
    }
}

// ════════════════════════════════════════════════════════════════════════════
//  托盘组件是【顶层】组件：inherits SystemTrayIcon，不能放进 Window 里，
//  且必须恰好包含一个 Menu 子元素。
//
//  ⚠ 它与 MainWindow 各自持有 global 的独立副本，二者不共享任何状态 ——
//  所有同步必须由 Rust 侧推送（SRS FR-25）。
//
//  ⚠ 托盘菜单是**原生菜单**，由操作系统绘制，无法应用本文件的设计语言；
//  这里只能保证文案与启用条件正确。
// ════════════════════════════════════════════════════════════════════════════
export component AppTray inherits SystemTrayIcon {
    in property <bool> web-running: false;
    in property <bool> busy: false;

    // 托盘图标用 logo.png（与标题栏 / 任务栏 / 报头同一张图）。
    // 为什么不是矢量：托盘图标走 `Image::to_rgba8()`，对 SVG 是按**内在尺寸**栅格化
    // —— 也就是每次启动都要把 910×941 整幅画一遍（实测 debug 档窗口 1.36s 才可见，
    // release 档 0.32~0.45s）。换成 PNG 后那一段变成一次位图解码（debug 档 598~666ms）。
    // ⚠ PNG 解码要靠 Cargo.toml 的 `image-default-formats`：少了它 Slint 是**静默**
    // 解不出来，托盘会"图标根本不出现"（ARCHITECTURE R-3）。
    icon: @image-url("../assets/logo.png");
    tooltip: "DSH Manager";

    callback show-window();
    callback open-web();
    callback start-web();
    callback stop-web();
    callback quit-app();
    /// 左键单击托盘图标。⚠ 名字**不能**叫 `clicked` —— Slint 1.18 不把
    /// `SystemTrayIcon.clicked` 这个**内建**回调暴露到生成的 Rust API 上
    /// （同理 `MainWindow` 也拿不到 `close-requested`），只能在组件体内转出去。
    callback tray-clicked();

    Menu {
        MenuItem {
            title: "显示主窗口";
            activated => { show-window(); }
        }
        MenuItem {
            title: "打开 DSH 网页";
            enabled: root.web-running && !root.busy;
            activated => { open-web(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "启动 dsh web";
            enabled: !root.web-running && !root.busy;
            activated => { start-web(); }
        }
        MenuItem {
            title: "停止 dsh web";
            enabled: root.web-running && !root.busy;
            activated => { stop-web(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "退出";
            activated => { quit-app(); }
        }
    }

    clicked => { root.tray-clicked(); }
}
